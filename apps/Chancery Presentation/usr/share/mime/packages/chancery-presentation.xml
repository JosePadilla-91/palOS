<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.chancery.presentation">
    <comment>Chancery Presentation document</comment>
    <comment xml:lang="fr">Présentation Chancery</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="x-office-presentation"/>
    <icon name="application-vnd.chancery.presentation"/>
    <magic priority="70">
      <match type="string" offset="30" value="mimetypeapplication/vnd.chancery.presentation"/>
    </magic>
    <glob pattern="*.pre" weight="60"/>
  </mime-type>
</mime-info>
