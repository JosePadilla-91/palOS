[Desktop Entry]
X-AppImage-Name=Mail
Name=Mail
Exec=AppRun %U
Terminal=false
Type=Application
Icon=paladin-mail
StartupWMClass=paladin-mail
GenericName=Email Client
GenericName[fr]=Client de courriel
GenericName[fr_CA]=Client de courriel
