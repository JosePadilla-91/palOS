Keywords=email;mail;imap;smtp;
X-GNOME-UsesNotifications=true
Comment=Read and send email
Comment[fr]=Lire et envoyer des courriels
Comment[fr_CA]=Lire et envoyer des courriels
Categories=Network;Email;
X-AppImage-Version=1.0
