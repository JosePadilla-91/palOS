#!/bin/sh
# palOS .app: runs on palOS's shared app runtime (electron-44).
HERE="$(dirname "$(readlink -f "$0")")"
RT=/usr/lib/paladin-runtime/electron-44
export PALOS_APP="${APPIMAGE:-$HERE}"
if [ ! -x "$RT/paladin-app" ]; then
  notify-send -i dialog-warning "Snap Booth" "This app needs palOS's app runtime (electron-44), which isn't on this computer." 2>/dev/null
  echo "Snap Booth: palOS's app runtime (electron-44) is missing" >&2; exit 1
fi
export PALOS_APP_DIR="$HERE/app" PALOS_APP_RESOURCES="$HERE/app"
exec "$RT/paladin-app" --ozone-platform=x11 "$@"
