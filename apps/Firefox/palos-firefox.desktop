[Desktop Entry]
X-AppImage-Name=Firefox
Type=Application
Name=Firefox
GenericName=Web Browser
GenericName[ar]=متصفح الويب
GenericName[de]=Webbrowser
GenericName[es]=Navegador web
GenericName[fr]=Navigateur Web
GenericName[fr_CA]=Navigateur Web
GenericName[it]=Browser web
GenericName[ja]=ウェブブラウザー
GenericName[ko]=웹 브라우저
GenericName[la]=Navigatrum interretiale
GenericName[nl]=Webbrowser
GenericName[pl]=Przeglądarka WWW
GenericName[pt]=Navegador web
GenericName[ru]=Веб-браузер
GenericName[tr]=Web tarayıcısı
GenericName[zh_CN]=网页浏览器
GenericName[zh_TW]=網頁瀏覽器
Comment=Browse the web
Comment[de]=Im Internet surfen
Comment[es]=Navegar por la web
Comment[fr]=Naviguer sur le Web
Comment[fr_CA]=Naviguer sur le Web
Comment[it]=Naviga sul web
Comment[ja]=ウェブを閲覧します
Comment[ko]=웹을 탐색합니다
Comment[nl]=Surf op het web
Comment[pl]=Przeglądaj internet
Comment[pt]=Navegar na web
Comment[ru]=Просмотр веб-страниц
Comment[tr]=Web'de gezinin
Comment[zh_CN]=浏览网页
Comment[zh_TW]=瀏覽網頁
Keywords=web;browser;internet;www;http;https;firefox;mozilla;
Exec=AppRun %u
Icon=palos-firefox
Terminal=false
StartupNotify=true
StartupWMClass=firefox
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/x-extension-htm;application/x-extension-html;application/x-extension-shtml;application/x-extension-xhtml;application/x-extension-xht;application/pdf;
Actions=new-window;new-private-window;
X-AppImage-Version=159.0.1

[Desktop Action new-window]
Name=New Window
Name[de]=Neues Fenster
Name[es]=Nueva ventana
Name[fr]=Nouvelle fenêtre
Name[fr_CA]=Nouvelle fenêtre
Name[it]=Nuova finestra
Name[ja]=新しいウィンドウ
Name[ko]=새 창
Name[nl]=Nieuw venster
Name[pl]=Nowe okno
Name[pt]=Nova janela
Name[ru]=Новое окно
Name[tr]=Yeni pencere
Name[zh_CN]=新建窗口
Name[zh_TW]=開新視窗
Exec=AppRun --new-window

[Desktop Action new-private-window]
Name=New Private Window
Name[de]=Neues privates Fenster
Name[es]=Nueva ventana privada
Name[fr]=Nouvelle fenêtre privée
Name[fr_CA]=Nouvelle fenêtre privée
Name[it]=Nuova finestra anonima
Name[ja]=新しいプライベートウィンドウ
Name[ko]=새 사생활 보호 창
Name[nl]=Nieuw privévenster
Name[pl]=Nowe okno prywatne
Name[pt]=Nova janela privada
Name[ru]=Новое приватное окно
Name[tr]=Yeni gizli pencere
Name[zh_CN]=新建隐私窗口
Name[zh_TW]=開新隱私視窗
Exec=AppRun --private-window
