[Desktop Entry]
TryExec=/Applications/Settings.app
X-Palos-App=/Applications/Settings.app
X-AppImage-Name=Settings
Type=Application
Name=Settings
Name[fr]=Réglages
Name[fr_CA]=Réglages
GenericName=System Settings
GenericName[fr]=Réglages du système
GenericName[fr_CA]=Réglages du système
Comment=Wi-Fi, appearance, displays, sound, users and more
Comment[fr]=Wi-Fi, apparence, écrans, son, utilisateurs et plus
Comment[fr_CA]=Wi-Fi, apparence, écrans, son, utilisateurs et plus
Exec="/Applications/Settings.app" %U
Icon=paladin-settings
Terminal=false
Categories=Settings;DesktopSettings;X-GNOME-Settings-Panel;
Keywords=Preferences;Settings;Wi-Fi;Network;Appearance;Dark;Dock;Display;Monitor;Sound;Volume;Users;Password;Time;Power;
StartupWMClass=Settings
OnlyShowIn=Paladin;
Actions=wifi;appearance;display;sound;
X-AppImage-Version=1.0.0

[Desktop Action wifi]
Name=Wi-Fi
Exec="/Applications/Settings.app" wifi

[Desktop Action appearance]
Name=Appearance
Exec="/Applications/Settings.app" appearance

[Desktop Action display]
Name=Displays
Exec="/Applications/Settings.app" display

[Desktop Action sound]
Name=Sound
Exec="/Applications/Settings.app" sound
