{
  "a11y.applications.screen-reader-enabled": false,
  "interface.clock-format": "24h",
  "interface.color-scheme": "default",
  "interface.cursor-size": 24,
  "interface.cursor-theme": "Paladin",
  "interface.document-font-name": "Noto Sans 11",
  "interface.enable-animations": true,
  "interface.font-antialiasing": "grayscale",
  "interface.font-hinting": "slight",
  "interface.font-name": "Noto Sans 11",
  "interface.font-rgba-order": "rgb",
  "interface.icon-theme": "palOS",
  "interface.monospace-font-name": "Noto Sans Mono 13",
  "interface.text-scaling-factor": 1.0,
  "interface.toolkit-accessibility": false,
  "peripherals.keyboard.numlock-state": true,
  "peripherals.mouse.double-click": 400,
  "screens.hsize": 2,
  "screens.vsize": 1,
  "screensaver.lock-enabled": true,
  "screensaver.lock-delay": 0,
  "session.idle-delay": 300,
  "sound.event-sounds": true,
  "sound.input-feedback-sounds": true,
  "sound.theme-name": "palos-ui",
  "wm.preferences.action-double-click-titlebar": "toggle-maximize",
  "wm.preferences.button-layout": "close,minimize,maximize:",
  "wm.preferences.titlebar-font": "Noto Sans 11"
}
