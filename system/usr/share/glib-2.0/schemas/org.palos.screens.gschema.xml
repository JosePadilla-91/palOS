<?xml version="1.0" encoding="UTF-8"?>
<!-- palOS: Screens (the separate desktops you switch between), laid out as a grid. Seeker's menu bar sets them,
     paladin-wm reads them. -->
<schemalist>
  <schema id="org.palos.screens" path="/org/palos/screens/">
    <key name="hsize" type="i">
      <range min="1" max="16"/>
      <default>2</default>
      <summary>Screens across</summary>
    </key>
    <key name="vsize" type="i">
      <range min="1" max="16"/>
      <default>1</default>
      <summary>Screens down</summary>
    </key>
  </schema>
</schemalist>
