[org.gnome.desktop.interface]
font-name='Noto Sans 11'
document-font-name='Noto Sans 11'
monospace-font-name='Noto Sans Mono 13'
# Paladin everywhere, from the very first screen (Ubuntu's Yaru theme is no longer installed)
gtk-theme='Paladin'
icon-theme='palOS'
cursor-theme='Paladin'

[org.gnome.desktop.wm.preferences]
titlebar-font='Noto Sans Bold 11'

# palOS interface sound effects (Trash, Dock, volume); Settings > Sound turns them off
[org.gnome.desktop.sound]
input-feedback-sounds=true
