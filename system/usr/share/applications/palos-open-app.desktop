[Desktop Entry]
Type=Application
Name=Open App
Name[fr]=Ouvrir l’app
Comment=Opens apps and programs with a double-click
Comment[fr]=Ouvre les apps et les programmes d’un double-clic
Exec=/usr/bin/palos-open-app %f
Icon=application-x-executable
NoDisplay=true
Terminal=false
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/x-executable;application/x-pie-executable;
