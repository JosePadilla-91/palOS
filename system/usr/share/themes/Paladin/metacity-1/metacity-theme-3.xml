<?xml version="1.0"?>
<metacity_theme>
<info>
  <name>Paladin</name>
  <author>Paladin</author>
  <copyright>Paladin, original artwork</copyright>
  <date>2026</date>
  <description>Paladin title bars, light: brushed steel with a glass sheen; ruby, amber and jade glass buttons, on the left.</description>
</info>

<frame_geometry name="normal" title_scale="medium" rounded_top_left="5" rounded_top_right="5">
  <distance name="left_width" value="1"/>
  <distance name="right_width" value="1"/>
  <distance name="bottom_height" value="1"/>
  <distance name="left_titlebar_edge" value="7"/>
  <distance name="right_titlebar_edge" value="7"/>
  <distance name="button_width" value="15"/>
  <distance name="button_height" value="15"/>
  <distance name="title_vertical_pad" value="4"/>
  <border name="title_border" left="2" right="2" top="3" bottom="3"/>
  <border name="button_border" left="0" right="4" top="0" bottom="0"/>
</frame_geometry>
<frame_geometry name="maximized" parent="normal" rounded_top_left="false" rounded_top_right="false">
  <distance name="left_width" value="0"/>
  <distance name="right_width" value="0"/>
  <distance name="bottom_height" value="0"/>
</frame_geometry>
<frame_geometry name="small" parent="normal" title_scale="small">
  <distance name="button_width" value="15"/>
  <distance name="button_height" value="15"/>
  <border name="title_border" left="2" right="2" top="1" bottom="1"/>
</frame_geometry>
<frame_geometry name="border" has_title="false" rounded_top_left="false" rounded_top_right="false">
  <distance name="left_width" value="1"/>
  <distance name="right_width" value="1"/>
  <distance name="bottom_height" value="1"/>
  <distance name="left_titlebar_edge" value="0"/>
  <distance name="right_titlebar_edge" value="0"/>
  <distance name="button_width" value="0"/>
  <distance name="button_height" value="0"/>
  <distance name="title_vertical_pad" value="1"/>
  <border name="title_border" left="0" right="0" top="0" bottom="0"/>
  <border name="button_border" left="0" right="0" top="0" bottom="0"/>
</frame_geometry>

<draw_ops name="nothing"></draw_ops>
<draw_ops name="frame_bg">
  <rectangle color="#dfe2e6" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>
<draw_ops name="titlebar_active">
  <image filename="titlebar-active.png" x="0" y="0" width="width" height="height" fill_type="scale"/>
  <line color="#f4f6f8" x1="0" y1="0" x2="width" y2="0"/>
  <line color="#7f8791" x1="0" y1="height - 1" x2="width" y2="height - 1"/>
</draw_ops>
<draw_ops name="titlebar_inactive">
  <image filename="titlebar-inactive.png" x="0" y="0" width="width" height="height" fill_type="scale"/>
  <line color="#f6f7f9" x1="0" y1="0" x2="width" y2="0"/>
  <line color="#a9b0b8" x1="0" y1="height - 1" x2="width" y2="height - 1"/>
</draw_ops>
<draw_ops name="title_active">
  <title color="#eef1f4" x="(0 `max` (frame_x_center - title_width / 2 - left_width)) `min` (width - title_width)" y="(((height - title_height) / 2) `max` 0) + 1"/>
  <title color="#1f2329" x="(0 `max` (frame_x_center - title_width / 2 - left_width)) `min` (width - title_width)" y="((height - title_height) / 2) `max` 0"/>
</draw_ops>
<draw_ops name="title_inactive">
  <title color="#f1f3f5" x="(0 `max` (frame_x_center - title_width / 2 - left_width)) `min` (width - title_width)" y="(((height - title_height) / 2) `max` 0) + 1"/>
  <title color="#5f6771" x="(0 `max` (frame_x_center - title_width / 2 - left_width)) `min` (width - title_width)" y="((height - title_height) / 2) `max` 0"/>
</draw_ops>
<draw_ops name="title_active_small"><include name="title_active"/></draw_ops>
<draw_ops name="title_inactive_small"><include name="title_inactive"/></draw_ops>
<draw_ops name="border_active">
  <rectangle color="#8f969f" x="0" y="0" width="width - 1" height="height - 1" filled="false"/>
</draw_ops>
<draw_ops name="border_inactive">
  <rectangle color="#b0b6be" x="0" y="0" width="width - 1" height="height - 1" filled="false"/>
</draw_ops>
<draw_ops name="close_normal">
  <image filename="close-normal.png" x="0" y="(height - 15) / 2" width="15" height="15"/>
</draw_ops>
<draw_ops name="close_prelight">
  <image filename="close-prelight.png" x="0" y="(height - 15) / 2" width="15" height="15"/>
</draw_ops>
<draw_ops name="close_pressed">
