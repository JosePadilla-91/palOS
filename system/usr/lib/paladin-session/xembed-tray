#!/usr/bin/python3
"""Old-style tray icons in the menu bar.

Some programs (Steam, Wine programs, older GTK and Java apps, and Electron apps such as Discord when they
start before the menu bar) still put their icon in a "system tray" the old X11 way (XEmbed). The menu bar
shows the modern kind (StatusNotifierItem). This keeps the old tray: each icon is held in a small hidden
window, its picture is copied into a modern tray item, and clicks on that item are passed back to the icon.
"""
import os
import sys
import time

import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib  # noqa: E402

from Xlib import X, Xatom, display as xdisplay, error as xerror  # noqa: E402
from Xlib.ext import composite, xtest  # noqa: E402,F401

S = 24                      # icon size in pixels
PARK = (-S * 4, -S * 4)     # where the hidden windows wait (off the screen)
BG = (236, 236, 236)        # backdrop for icons drawn without transparency; made see-through afterwards
REQUEST_DOCK = 0
XEMBED_EMBEDDED_NOTIFY = 0
WATCHER = 'org.kde.StatusNotifierWatcher'

SNI_XML = """<node><interface name="org.kde.StatusNotifierItem">
<property name="Category" type="s" access="read"/><property name="Id" type="s" access="read"/>
<property name="Title" type="s" access="read"/><property name="Status" type="s" access="read"/>
<property name="WindowId" type="i" access="read"/><property name="IconName" type="s" access="read"/>
<property name="IconPixmap" type="a(iiay)" access="read"/><property name="OverlayIconName" type="s" access="read"/>
<property name="AttentionIconName" type="s" access="read"/><property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
<property name="ItemIsMenu" type="b" access="read"/><property name="Menu" type="o" access="read"/>
<method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
<method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
<method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
<method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
<signal name="NewIcon"/><signal name="NewTitle"/><signal name="NewStatus"><arg type="s"/></signal>
</interface></node>"""
SNI_INFO = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]


def log(*a):
    print('[xembed-tray]', *a, file=sys.stderr, flush=True)


class Icon:
    """one docked icon: its holder window and the tray item that shows it"""

    def __init__(self, tray, wid):
        self.tray, self.wid = tray, wid
        d = tray.d
        self.win = d.create_resource_object('window', wid)
        self.last = None
        self.pixmap = []
        depth = self.win.get_geometry().depth
        kw = dict(override_redirect=1, event_mask=X.StructureNotifyMask | X.ExposureMask, border_pixel=0)
        if depth == 32 and tray.argb:
            visual, cmap = tray.argb
            kw.update(colormap=cmap, background_pixel=0)
        else:
            depth, visual = X.CopyFromParent, X.CopyFromParent
            kw.update(background_pixel=(BG[0] << 16) | (BG[1] << 8) | BG[2])
        self.depth = depth
        self.holder = tray.root.create_window(PARK[0], PARK[1], S, S, 0, depth, X.InputOutput, visual, **kw)
        # never painted on screen: fully see-through to the compositor
        self.holder.change_property(d.intern_atom('_NET_WM_WINDOW_OPACITY'), Xatom.CARDINAL, 32, [0])
        self.holder.change_property(d.intern_atom('_NET_WM_WINDOW_TYPE'), Xatom.ATOM, 32, [d.intern_atom('_NET_WM_WINDOW_TYPE_DOCK')])
        try:
            self.holder.composite_redirect_window(composite.RedirectAutomatic)
        except Exception:
            pass
        self.win.change_attributes(event_mask=X.StructureNotifyMask | X.PropertyChangeMask)
        self.win.reparent(self.holder, 0, 0)
        self.win.configure(x=0, y=0, width=S, height=S)
        self.holder.map()
        self.win.map()
        self.win.send_event(_client_message(d, self.win, '_XEMBED', [X.CurrentTime, XEMBED_EMBEDDED_NOTIFY, 0, self.holder.id, 0]))
        d.flush()
        self.name, self.title = self._names()
        # the tray item: its own bus connection, so it disappears with the icon
        self.bus = None
        self.reg = None
        self._connect()

    def _names(self):
        cls, title = '', ''
        try:
            c = self.win.get_wm_class()
            if c:
                cls = c[1] or c[0]
        except Exception:
            pass
        try:
            t = self.win.get_full_property(self.tray.d.intern_atom('_NET_WM_NAME'), self.tray.d.intern_atom('UTF8_STRING'))
            title = t.value.decode('utf-8', 'replace') if t else (self.win.get_wm_name() or '')
        except Exception:
            pass
        return cls or 'tray-icon', title or cls or 'Tray Icon'

    def _connect(self):
        try:
            addr = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
            self.bus = Gio.DBusConnection.new_for_address_sync(
                addr, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
            self.reg = self.bus.register_object('/StatusNotifierItem', SNI_INFO, self._call, self._prop, None)
        except Exception as e:
            log('cannot offer tray item:', e)
            self.bus = None

    def register(self):
        if not self.bus:
            return
        self.bus.call(WATCHER, '/StatusNotifierWatcher', WATCHER, 'RegisterStatusNotifierItem',
                      GLib.Variant('(s)', ('/StatusNotifierItem',)), None, Gio.DBusCallFlags.NONE, 3000, None, None, None)

    def _prop(self, conn, sender, path, iface, prop):
        v = {
            'Category': GLib.Variant('s', 'ApplicationStatus'), 'Id': GLib.Variant('s', self.name),
            'Title': GLib.Variant('s', self.title), 'Status': GLib.Variant('s', 'Active'),
            'WindowId': GLib.Variant('i', 0), 'IconName': GLib.Variant('s', ''),
            'IconPixmap': GLib.Variant('a(iiay)', self.pixmap), 'OverlayIconName': GLib.Variant('s', ''),
            'AttentionIconName': GLib.Variant('s', ''), 'ToolTip': GLib.Variant('(sa(iiay)ss)', ('', [], self.title, '')),
            'ItemIsMenu': GLib.Variant('b', False), 'Menu': GLib.Variant('o', '/'),
        }
        return v.get(prop)

    def _call(self, conn, sender, path, iface, method, params, invocation):
        invocation.return_value(None)
        if method in ('Activate', 'SecondaryActivate', 'ContextMenu'):
            button = {'Activate': 1, 'SecondaryActivate': 2, 'ContextMenu': 3}[method]
            GLib.timeout_add(120, lambda: self.tray.click(self, button) and False)
        elif method == 'Scroll':
            delta = params.unpack()[0]
            GLib.timeout_add(60, lambda: self.tray.click(self, 4 if delta < 0 else 5) and False)

    def _grab(self, composited):
        try:
            if composited:
                pix = self.holder.composite_name_window_pixmap()
                img = pix.get_image(0, 0, S, S, X.ZPixmap, 0xffffffff)
                pix.free()
            else:
                img = self.holder.get_image(0, 0, S, S, X.ZPixmap, 0xffffffff)
        except Exception:
            return None
        data = img.data
        if isinstance(data, str):
            data = data.encode('latin-1')
        return data if len(data) >= S * S * 4 else None

    @staticmethod
    def _blank(data):
        """one colour everywhere: the icon hasn't really been drawn (an app that paints late, or a copy that came
        back empty). Published as is, it showed as a solid black square in the menu bar."""
        first = data[0:4]
        return all(data[i:i + 4] == first for i in range(0, S * S * 4, 4))

    def capture(self):
        """copy the icon's current picture into the tray item (only when it changed)"""
        data = self._grab(True)
        if data is None or self._blank(data):
            other = self._grab(False)          # some apps' icons only show up in a direct copy
            if other is not None and not self._blank(other):
                data = other
        if data is None or self._blank(data) or data == self.last:
            return
        self.last = data
        out = bytearray(S * S * 4)
        argb = self.depth == 32
        seen = False
        for i in range(S * S):
            b, g, r, a = data[i * 4], data[i * 4 + 1], data[i * 4 + 2], data[i * 4 + 3]
            if argb:
                if a and a < 255:            # X keeps colours premultiplied; tray pictures are not
                    r, g, b = min(255, r * 255 // a), min(255, g * 255 // a), min(255, b * 255 // a)
            else:
                # the grey backdrop becomes see-through, with a little tolerance: an exact match left a light
                # fringe of almost-backdrop pixels around the icon's smoothed edges on the dark menu bar
                d = max(abs(r - BG[0]), abs(g - BG[1]), abs(b - BG[2]))
                a = 0 if d <= 6 else 255
            if a:
                seen = True
            out[i * 4:i * 4 + 4] = bytes((a, r, g, b))
        if not seen:
            return                            # not drawn yet
        self.pixmap = [(S, S, bytes(out))]
        if self.bus:
            self.bus.emit_signal(None, '/StatusNotifierItem', 'org.kde.StatusNotifierItem', 'NewIcon', None)

    def close(self):
        try:
            if self.bus:
                if self.reg:
                    self.bus.unregister_object(self.reg)
                self.bus.close_sync(None)
        except Exception:
            pass
        self.bus = None
        try:
            self.holder.destroy()
        except Exception:
            pass


def _client_message(d, win, atom, data):
    from Xlib.protocol import event
    return event.ClientMessage(window=win, client_type=d.intern_atom(atom), data=(32, data))


class Tray:
    def __init__(self):
        self.d = xdisplay.Display()
        self.d.set_error_handler(lambda *a: None)       # icons come and go; their windows may already be gone
        self.scr = self.d.screen()
        self.root = self.scr.root
        self.icons = {}
        self.argb = None
        self.watcher_up = False

    def start(self):
        d = self.d
        sel = d.intern_atom(f'_NET_SYSTEM_TRAY_S{d.get_default_screen()}')
        if d.get_selection_owner(sel) not in (X.NONE, 0) and getattr(d.get_selection_owner(sel), 'id', 0):
            log('another system tray is running')
            return False
        self.owner = self.root.create_window(-1, -1, 1, 1, 0, X.CopyFromParent, override_redirect=1)
        # a transparent kind of window for icons that support it
        for dep in self.scr.allowed_depths:
            if dep.depth == 32:
                for v in dep.visuals:
                    if v.visual_class == X.TrueColor:
                        self.argb = (v.visual_id, self.root.create_colormap(v.visual_id, X.AllocNone))
                        break
            if self.argb:
                break
        if self.argb:
            self.owner.change_property(d.intern_atom('_NET_SYSTEM_TRAY_VISUAL'), d.intern_atom('VISUALID'), 32, [self.argb[0]])
        self.owner.change_property(d.intern_atom('_NET_SYSTEM_TRAY_ORIENTATION'), Xatom.CARDINAL, 32, [0])
        self.owner.set_selection_owner(sel, X.CurrentTime)
        d.sync()
        if getattr(d.get_selection_owner(sel), 'id', 0) != self.owner.id:
            log('could not become the system tray')
            return False
        from Xlib.protocol import event
        self.root.send_event(event.ClientMessage(window=self.root, client_type=d.intern_atom('MANAGER'),
                                                 data=(32, [X.CurrentTime, sel, self.owner.id, 0, 0])),
                             event_mask=X.StructureNotifyMask)
        d.flush()
        self.opcode = d.intern_atom('_NET_SYSTEM_TRAY_OPCODE')
        GLib.io_add_watch(d.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN, lambda *a: self.pump() or True)
        GLib.timeout_add(250, lambda: self.pump() or True)
        GLib.timeout_add(1000, lambda: self.refresh() or True)
        Gio.bus_watch_name(Gio.BusType.SESSION, WATCHER, Gio.BusNameWatcherFlags.NONE, self._watcher_on, self._watcher_off)
        log('ready')
        return True

    def _watcher_on(self, *a):
        self.watcher_up = True
        for ic in self.icons.values():
            ic.register()

    def _watcher_off(self, *a):
        self.watcher_up = False

    def pump(self):
        d = self.d
        while d.pending_events():
            ev = d.next_event()
            try:
                self.handle(ev)
            except Exception as e:
                log('event error:', e)

    def handle(self, ev):
        if ev.type == X.ClientMessage and ev.client_type == self.opcode:
            fmt, data = ev.data
            if data[1] == REQUEST_DOCK:
                wid = data[2]
                if wid and wid not in self.icons:
                    try:
                        ic = Icon(self, wid)
                    except Exception as e:
                        log('cannot hold icon', hex(wid), e)
                        return
                    self.icons[wid] = ic
                    log('holding', ic.name, hex(wid))
                    GLib.timeout_add(300, lambda: (ic.capture(), self.watcher_up and ic.register()) and False)
        elif ev.type in (X.DestroyNotify, X.ReparentNotify, X.UnmapNotify):
            wid = ev.window.id
            ic = self.icons.get(wid)
            if not ic:
                return
            if ev.type == X.ReparentNotify and ev.parent.id == ic.holder.id:
                return
            if ev.type == X.UnmapNotify:
                return                                  # hidden for a moment; it may come back
            del self.icons[wid]
            log('released', ic.name)
            ic.close()
        elif ev.type == X.SelectionClear:
            log('another tray took over')
            for ic in list(self.icons.values()):
                ic.close()
            GLib.idle_add(lambda: sys.exit(0))

    def refresh(self):
        for ic in list(self.icons.values()):
            ic.capture()

    def click(self, ic, button):
        """press a mouse button on the icon: briefly put it under the pointer, invisible, and click it"""
        d = self.d
        try:
            p = self.root.query_pointer()
            x, y = p.root_x - S // 2, p.root_y - S // 2
            ic.holder.configure(x=x, y=y, stack_mode=X.Above)
            d.sync()
            time.sleep(0.03)
            xtest.fake_input(d, X.MotionNotify, x=p.root_x, y=p.root_y)
            xtest.fake_input(d, X.ButtonPress, button)
            d.sync()
            time.sleep(0.02)
            xtest.fake_input(d, X.ButtonRelease, button)
            d.sync()
        except Exception as e:
            log('click failed:', e)
        GLib.timeout_add(400, lambda: (ic.holder.configure(x=PARK[0], y=PARK[1]), d.flush()) and False)


def main():
    if not os.environ.get('DISPLAY'):
        return
    tray = Tray()
    if not tray.start():
        return
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
