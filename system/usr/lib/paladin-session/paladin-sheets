#!/usr/bin/python3
"""Paladin sheets for every app.

palOS's own apps draw their panels (messages, questions, Open and Save) as sheets inside the window.
Other apps (GTK and Qt apps, Wine programs, Electron's built-in dialogs) open their dialogs as separate
windows. This keeps those dialogs where a sheet would be: attached to the top centre of the window they
belong to, just under its title bar, without a title bar of their own, rolling out of the window's top
edge (Compiz's Roll Up animation, set up by the session) and moving with the window.

Dialogs that say which window they belong to (WM_TRANSIENT_FOR) are handled. A dialog that doesn't say, but
comes from the same program as the window in front (same process, or same WM_CLASS), is given to that window:
otherwise the window manager can put it behind, and with a full-screen window the program looks frozen.
Full-screen windows get their sheets too, kept above them. Tool palettes, menus, notifications and password
prompts that belong to no window are left alone.

Turn it off for yourself:  touch ~/.config/paladin-session/no-sheets   (then log out and back in)."""
import os
import sys
import time

from Xlib import X, Xatom, display, error
from Xlib.protocol import event as xevent

CONF = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'paladin-session')


def log(*a):
    print('paladin-sheets:', *a, file=sys.stderr, flush=True)


class Sheets:
    def __init__(self):
        self.d = display.Display()
        # windows come and go all the time; a window that vanished before we looked at it isn't an error
        self.d.set_error_handler(lambda *a, **k: None)
        self.root = self.d.screen().root
        A = self.d.intern_atom
        self.A_TYPE = A('_NET_WM_WINDOW_TYPE')
        self.T_DIALOG = A('_NET_WM_WINDOW_TYPE_DIALOG')
        self.T_NORMAL = A('_NET_WM_WINDOW_TYPE_NORMAL')
        self.T_SKIP = {A('_NET_WM_WINDOW_TYPE_UTILITY'), A('_NET_WM_WINDOW_TYPE_TOOLBAR'), A('_NET_WM_WINDOW_TYPE_MENU'),
                       A('_NET_WM_WINDOW_TYPE_SPLASH'), A('_NET_WM_WINDOW_TYPE_NOTIFICATION'), A('_NET_WM_WINDOW_TYPE_DOCK'),
                       A('_NET_WM_WINDOW_TYPE_DESKTOP'), A('_NET_WM_WINDOW_TYPE_TOOLTIP'), A('_NET_WM_WINDOW_TYPE_POPUP_MENU'),
                       A('_NET_WM_WINDOW_TYPE_DROPDOWN_MENU'), A('_NET_WM_WINDOW_TYPE_COMBO'), A('_NET_WM_WINDOW_TYPE_DND')}
        self.A_STATE = A('_NET_WM_STATE')
        self.S_MODAL = A('_NET_WM_STATE_MODAL')
        self.S_SKIP_TASKBAR = A('_NET_WM_STATE_SKIP_TASKBAR')
        self.S_FULLSCREEN = A('_NET_WM_STATE_FULLSCREEN')
        self.A_EXTENTS = A('_NET_FRAME_EXTENTS')
        self.A_MOTIF = A('_MOTIF_WM_HINTS')
        self.A_SHEET = A('_PALADIN_SHEET')        # marks a dialog we attached (Seeker and the dock can skip it)
        self.A_GTK_EXTENTS = A('_GTK_FRAME_EXTENTS')
        self.watch = {}          # client window id -> window (new windows we are watching)
        self.sheets = {}         # dialog client id -> parent client id
        self.parents = {}        # parent frame id -> parent client id
        self.A_ACTIVE = A('_NET_ACTIVE_WINDOW')
        self.A_PID = A('_NET_WM_PID')
        self.S_ABOVE = A('_NET_WM_STATE_ABOVE')
        self.A_TRANSIENT = A('WM_TRANSIENT_FOR')
        self.fullscreen_sheets = set()   # dialog ids attached to a full-screen window (kept above it)
        self.root.change_attributes(event_mask=X.SubstructureNotifyMask | X.PropertyChangeMask)
        self.d.flush()

    # ------------------------------------------------------------ helpers
    def prop(self, w, atom, typ=X.AnyPropertyType):
        try:
            p = w.get_full_property(atom, typ)
            return list(p.value) if p else []
        except error.XError:
            return []

    def frame_of(self, w):
        """The top-level window (Compiz's frame) a client window sits in."""
        try:
            cur = w
            while True:
                t = cur.query_tree()
                if t.parent.id == self.root.id or t.parent.id == 0:
                    return cur
                cur = t.parent
        except error.XError:
            return None

    def abs_geometry(self, w):
        try:
            g = w.get_geometry()
            c = w.translate_coords(self.root, 0, 0)
            return -c.x, -c.y, g.width, g.height
        except error.XError:
            return None

    def adopt(self, w):
        """A dialog that names no window: give it to the front window when it comes from the same program."""
        types = set(self.prop(w, self.A_TYPE, Xatom.ATOM))
        state = set(self.prop(w, self.A_STATE, Xatom.ATOM))
        if types & self.T_SKIP:
            return None
        if self.T_DIALOG not in types and self.S_MODAL not in state:
            return None             # a new main window of the program, not a dialog
        act = self.prop(self.root, self.A_ACTIVE, Xatom.WINDOW)
        if not act or act[0] in (0, w.id):
            return None
        front = self.d.create_resource_object('window', act[0])
        same = False
        mine, theirs = self.prop(w, self.A_PID, Xatom.CARDINAL), self.prop(front, self.A_PID, Xatom.CARDINAL)
        if mine and theirs and mine[0] == theirs[0]:
            same = True
        else:
            try:
                c1, c2 = w.get_wm_class(), front.get_wm_class()
                same = bool(c1 and c2 and c1[1] and c1[1].lower() == c2[1].lower())
            except error.XError:
                same = False
        if not same:
            return None
        try:
            w.change_property(self.A_TRANSIENT, Xatom.WINDOW, 32, [front.id])
            self.d.flush()
        except error.XError:
            return None
        return front

    def wants_sheet(self, w):
        """A dialog that belongs to a normal window."""
        try:
            parent = w.get_wm_transient_for()
        except error.XError:
            return None
        if not parent or parent.id in (0, self.root.id):
            parent = self.adopt(w)
            if parent is None:
                return None
        types = set(self.prop(w, self.A_TYPE, Xatom.ATOM))
        if types & self.T_SKIP:
            return None
        state = set(self.prop(w, self.A_STATE, Xatom.ATOM))
        if types and self.T_DIALOG not in types and self.S_MODAL not in state:
            return None
        if not types and self.S_MODAL not in state:
            # untyped transients are dialogs by the EWMH rules
            pass
        try:
            ptypes = set(self.prop(parent, self.A_TYPE, Xatom.ATOM))
        except error.XError:
            return None
        if ptypes and self.T_NORMAL not in ptypes and self.T_DIALOG not in ptypes:
            return None
        return parent

    def is_fullscreen(self, w):
        return self.S_FULLSCREEN in set(self.prop(w, self.A_STATE, Xatom.ATOM))

    def set_above(self, w, on):
        """_NET_WM_STATE add/remove ABOVE: a full-screen window's sheet must be drawn over it."""
        try:
            ev = xevent.ClientMessage(window=w, client_type=self.A_STATE, data=(32, [1 if on else 0, self.S_ABOVE, 0, 1, 0]))
            self.root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            self.d.flush()
        except error.XError:
            pass

    # ------------------------------------------------------------ placing
    def target(self, dialog, parent):
        """Where the dialog's top-left goes: centred on the parent, its top edge on the parent's title bar's
        lower edge (the top of the parent's content)."""
        pg = self.abs_geometry(parent)
        dg = self.abs_geometry(dialog)
        if not pg or not dg:
            return None
        px, py, pw, ph = pg
        _, _, dw, dh = dg
        # a sheet fits inside its window (as in palOS), as far as the dialog's own minimum size allows
        nw, nh = dw, dh
        try:
            hints = dialog.get_wm_normal_hints()
            minw = hints.min_width if hints and hints.flags & 16 else 0      # PMinSize
            minh = hints.min_height if hints and hints.flags & 16 else 0
        except error.XError:
            minw = minh = 0
        if dw > pw - 40 and pw - 40 >= max(minw, 200):
            nw = pw - 40
        if dh > ph - 24 and ph - 24 >= max(minh, 120):
            nh = ph - 24
        dw, dh = nw, nh
        # client-side decorated dialogs (GTK headerbars) have an invisible shadow margin around them
        gext = self.prop(dialog, self.A_GTK_EXTENTS, Xatom.CARDINAL)
        gl, gr, gt, _ = (gext + [0, 0, 0, 0])[:4]
        pext = self.prop(parent, self.A_GTK_EXTENTS, Xatom.CARDINAL)
        pl, prr, pt, _ = (pext + [0, 0, 0, 0])[:4]
        content_x, content_y, content_w = px + pl, py + pt, pw - pl - prr
        x = content_x + (content_w - (dw - gl - gr)) // 2 - gl
        y = content_y - gt
        # keep it on screen
        sw, sh = self.d.screen().width_in_pixels, self.d.screen().height_in_pixels
        x = max(-gl, min(x, sw - dw + gr))
        y = max(-gt, min(y, sh - 40))
        return x, y, dw, dh

    def undecorate(self, dialog):
        # flags=2 (decorations given), decorations=0 (none): the sheet has no title bar of its own
        try:
            dialog.change_property(self.A_MOTIF, self.A_MOTIF, 32, [2, 0, 0, 0, 0])
            st = set(self.prop(dialog, self.A_STATE, Xatom.ATOM))
            st.add(self.S_SKIP_TASKBAR)
            st.add(self.S_MODAL)          # modal: the window manager keeps it above the window it belongs to
            dialog.change_property(self.A_STATE, Xatom.ATOM, 32, sorted(st))
            dialog.change_property(self.A_SHEET, Xatom.CARDINAL, 32, [1])
        except error.XError:
            pass

    def place(self, dialog, parent, mapped):
        t = self.target(dialog, parent)
        if not t:
            return
        x, y, w, h = t
        try:
            if mapped:
                self.send_move(dialog, x, y, w, h)     # static gravity: x, y are where the dialog itself goes
            else:
                hints = dialog.get_wm_normal_hints()
                if hints is not None:
                    hints.flags |= 1        # USPosition: "put it exactly here"
                    hints.x, hints.y = x, y
                    dialog.set_wm_normal_hints(hints)
                dialog.configure(x=x, y=y, width=w, height=h)
        except error.XError:
            pass

    def send_move(self, w, x, y, width=0, height=0):
        """_NET_MOVERESIZE_WINDOW: ask the window manager to move (and size) the window (gravity static)."""
        flags = (1 << 8) | (1 << 9) | (2 << 12) | 10
        if width:
            flags |= (1 << 10) | (1 << 11)
        try:
            ev = xevent.ClientMessage(window=w, client_type=self.d.intern_atom('_NET_MOVERESIZE_WINDOW'),
                                      data=(32, [flags, x, y, width, height]))
            self.root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
        except error.XError:
            pass

    def attach(self, dialog, parent, mapped):
        if dialog.id not in self.sheets:
            self.undecorate(dialog)
        self.sheets[dialog.id] = parent.id
        if self.is_fullscreen(parent):
            self.fullscreen_sheets.add(dialog.id)
            if mapped:
                self.set_above(dialog, True)
                self.activate(dialog)
        pf = self.frame_of(parent)
        if pf is not None:
            self.parents[pf.id] = parent.id
            try:
                pf.change_attributes(event_mask=X.StructureNotifyMask)
            except error.XError:
                pass
        self.place(dialog, parent, mapped)

    def follow(self, parent_id):
        parent = self.d.create_resource_object('window', parent_id)
        for did, pid in list(self.sheets.items()):
            if pid == parent_id:
                self.place(self.d.create_resource_object('window', did), parent, True)

    def activate(self, w):
        """Bring a sheet to the front (and give it the keyboard) when its window is brought forward, so it can
        never end up behind the window it belongs to."""
        try:
            ev = xevent.ClientMessage(window=w, client_type=self.A_ACTIVE, data=(32, [2, X.CurrentTime, 0, 0, 0]))
            self.root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            self.d.flush()
        except error.XError:
            pass

    def on_active(self):
        act = self.prop(self.root, self.A_ACTIVE, Xatom.WINDOW)
        if not act:
            return
        # a full-screen window's sheet floats above it only while that program is in front
        for did in list(self.fullscreen_sheets):
            pid = self.sheets.get(did)
            if pid is None:
                self.fullscreen_sheets.discard(did)
                continue
            self.set_above(self.d.create_resource_object('window', did), act[0] in (did, pid))
        for did, pid in list(self.sheets.items()):
            if pid == act[0]:
                self.activate(self.d.create_resource_object('window', did))
                break

    # ------------------------------------------------------------ events
    def consider(self, w, mapped):
        parent = self.wants_sheet(w)
        if parent is not None:
            self.attach(w, parent, mapped)

    def run(self):
        last = {}
        while True:
            ev = self.d.next_event()
            try:
                t = ev.type
                if t == X.CreateNotify:
                    w = ev.window
                    if ev.override:
                        continue
                    try:
                        w.change_attributes(event_mask=X.PropertyChangeMask | X.StructureNotifyMask)
                    except error.XError:
                        continue
                    self.watch[w.id] = w
                elif t == X.PropertyNotify and ev.window.id == self.root.id:
                    if ev.atom == self.A_ACTIVE and self.sheets:
                        self.on_active()
                elif t == X.PropertyNotify and ev.window.id in self.watch:
                    if ev.window.id not in self.sheets:
                        self.consider(ev.window, False)
                elif t == X.MapNotify and ev.window.id in self.watch:
                    w = ev.window
                    if w.id in self.sheets:
                        parent = self.d.create_resource_object('window', self.sheets[w.id])
                        # the window manager may have placed it before our request arrived: put it right
                        self.place(w, parent, True)
                        if w.id in self.fullscreen_sheets:
                            self.set_above(w, True)
                            self.activate(w)
                    else:
                        self.consider(w, True)
                elif t == X.ConfigureNotify and ev.window.id in self.parents:
                    pid = self.parents[ev.window.id]
                    for did, p2 in list(self.sheets.items()):      # the window was raised: its sheet comes with it
                        if p2 == pid:
                            try:
                                self.d.create_resource_object('window', did).configure(stack_mode=X.Above)
                            except error.XError:
                                pass
                    now = time.monotonic()
                    if now - last.get(pid, 0) > 0.012:     # follow the window without flooding the X server
                        last[pid] = now
                        self.follow(pid)
                elif t == X.DestroyNotify:
                    wid = ev.window.id
                    self.watch.pop(wid, None)
                    self.sheets.pop(wid, None)
                    self.fullscreen_sheets.discard(wid)
                    if wid in self.parents:
                        self.parents.pop(wid, None)
                elif t == X.UnmapNotify and ev.window.id in self.sheets:
                    self.sheets.pop(ev.window.id, None)
                    self.fullscreen_sheets.discard(ev.window.id)
            except error.XError:
                pass


def main():
    if os.path.exists(os.path.join(CONF, 'no-sheets')):
        return 0
    while True:
        try:
            Sheets().run()
        except error.ConnectionClosedError:
            return 0          # the X server is gone: the session is over
        except Exception as e:  # noqa: BLE001
            log('restarting after', repr(e))
            time.sleep(1)


if __name__ == '__main__':
    sys.exit(main())
