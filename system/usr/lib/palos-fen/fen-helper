#!/usr/bin/python3
"""Fen's picture converter. Reads JSON requests on stdin, one per line, answers on stdout:
  {"id":1,"cmd":"convert","src":IN,"dst":OUT.png}         full picture as PNG (TIFF, HEIC, camera RAW...)
  {"id":2,"cmd":"thumb","src":IN,"dst":OUT.png,"size":128} a small PNG for the filmstrip
The pictures are read by kibble-image (palOS's own picture reader), turned the right way up from their
camera orientation. Camera RAW files show the picture the camera embedded (what the camera's own screen
shows)."""
import json
import os
import subprocess
import sys

KI = '/usr/lib/kibble/bin/kibble-image'
RAW = {'cr2', 'cr3', 'crw', 'nef', 'nrw', 'arw', 'srf', 'sr2', 'dng', 'raf', 'orf', 'rw2', 'pef', 'srw', 'x3f', 'raw', 'rwl', 'mrw',
       'kdc', 'dcr', '3fr', 'erf', 'mef', 'mos', 'iiq'}


def raw_picture(src):
    """the picture a camera RAW file carries (or, without one, the RAW developed: slower)"""
    for cmd in (['dcraw', '-e', '-c', src], ['exiftool', '-b', '-JpgFromRaw', src], ['exiftool', '-b', '-PreviewImage', src]):
        try:
            out = subprocess.run(cmd, capture_output=True, timeout=60).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        if out and len(out) > 1000:
            return out
    out = subprocess.run(['dcraw', '-w', '-c', src], capture_output=True, timeout=180).stdout
    if not out:
        raise RuntimeError('This camera RAW file can’t be shown.')
    return out


def convert(src, dst, size=None):
    ext = os.path.splitext(src)[1].lstrip('.').lower()
    data = raw_picture(src) if ext in RAW else None
    args = [KI, 'convert', '-' if data is not None else src, dst] + ([str(int(size))] if size else [])
    r = subprocess.run(args, input=data, capture_output=True, timeout=180)
    if r.returncode != 0:
        raise RuntimeError((r.stderr.decode(errors='replace').strip().replace('kibble-image: ', '') or 'This picture can’t be shown.'))


for line in sys.stdin:
    try:
        req = json.loads(line)
    except ValueError:
        continue
    rid = req.get('id')
    try:
        if req['cmd'] == 'convert':
            convert(req['src'], req['dst'])
        elif req['cmd'] == 'thumb':
            convert(req['src'], req['dst'], int(req.get('size', 128)))
        else:
            raise RuntimeError('unknown command')
        res = {'id': rid, 'ok': True, 'result': req['dst']}
    except (RuntimeError, OSError, subprocess.SubprocessError, KeyError) as e:
        res = {'id': rid, 'ok': False, 'error': str(e)}
    sys.stdout.write(json.dumps(res) + '\n')
    sys.stdout.flush()
