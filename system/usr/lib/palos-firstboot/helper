        return {'ok': False, 'error': 'busy'}
    MIG.cleanup()
    return {'ok': True}


# ------------------------------------------------------------------ graphics drivers (NVIDIA)
STORE_HELPER = '/usr/lib/palos-store/store-helper'
STORE_BACKEND = '/usr/lib/palos-store/store-backend'
DRV = {'running': False, 'kind': None, 'pct': 0, 'step': '', 'result': None, 'error': None}


def nvidia_gpus():
    """Names of the NVIDIA graphics chips in this computer (PCI vendor 10de, display class 03)."""
    out = []
    for d in glob.glob('/sys/bus/pci/devices/*'):
        try:
            vendor = open(os.path.join(d, 'vendor')).read().strip().lower()
            cls = open(os.path.join(d, 'class')).read().strip().lower()
        except OSError:
            continue
        if vendor != '0x10de' or not cls.startswith('0x03'):
            continue
        name = 'NVIDIA graphics'
        try:
            r = subprocess.run(['lspci', '-mm', '-s', os.path.basename(d)], capture_output=True, text=True, timeout=5)
            f = re.findall(r'"([^"]*)"', r.stdout)
            if len(f) >= 3 and f[2]:
                name = f[2] if 'nvidia' in f[2].lower() else 'NVIDIA ' + f[2]
                m = re.search(r'\[(.+)\]', name)
                if m:
                    name = 'NVIDIA ' + m.group(1)
        except (OSError, subprocess.TimeoutExpired):
            pass
        out.append(name)
    return out


def a_gpu(_):
    g = nvidia_gpus()
    loaded = ''
    try:
        # NVIDIA's driver running, or installed already (by the installer) and waiting for the restart
        if os.path.exists('/sys/module/nvidia') or os.path.exists('/var/lib/palos-nvidia/installed.json'):
            loaded = 'nvidia'
    except OSError:
        pass
    return {'ok': True, 'nvidia': bool(g), 'names': g, 'driver': loaded}


def _drv_job(kind, fn):
    if DRV['running']:
        return {'ok': False, 'error': 'busy'}
    DRV.update({'running': True, 'kind': kind, 'pct': 0, 'step': '', 'result': None, 'error': None})

    def body():
        try:
            DRV['result'] = fn()
        except Exception as e:  # noqa: BLE001
            DRV['error'] = str(e)
            log('drivers:', repr(e))
        DRV['running'] = False
    import threading
    threading.Thread(target=body, daemon=True).start()
    return {'ok': True}


def _store(args):
    """Run the Store's helper (we're root already), following its progress lines."""
    env = dict(os.environ, DEBIAN_FRONTEND='noninteractive', LC_ALL='C.UTF-8')
    p = subprocess.Popen([STORE_HELPER] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
    err, reason = [], []           # reason: the helper's own explanation (palos:error:), shown instead of apt's output
    import threading
    threading.Thread(target=lambda: err.extend(p.stderr.readlines()[-20:]), daemon=True).start()
    for line in p.stdout:
        line = line.strip()
        if line.startswith('palos:step:'):
            DRV['step'] = line[11:]
        elif line.startswith('palos:error:'):
            reason.append(line[12:])
        elif line.startswith('pmstatus:') or line.startswith('dlstatus:'):
            f = line.split(':', 3)
            try:
                pct = float(f[2])
                DRV['pct'] = int(pct / 2) if f[0] == 'dlstatus' else 50 + int(pct / 2)
            except (IndexError, ValueError):
                pass
    rc = p.wait()
    if rc != 0:
        if reason:
            raise RuntimeError(reason[-1])
        tail = ' '.join(x.strip() for x in err if x.strip())[-300:]
        raise RuntimeError(tail or f'the driver couldn’t be installed ({rc})')
    return rc


def a_drv_scan(_):
    """palOS's NVIDIA driver for this computer (palos-nvidia): one driver, NVIDIA's own, for the chips it runs."""
    def scan():
        DRV['step'] = 'Getting the list of drivers'
        r = subprocess.run(['/usr/lib/palos-nvidia/palos-nvidia', 'status', '--json'], capture_output=True, text=True, timeout=60)
        try:
            st = json.loads(r.stdout)
        except ValueError:
            raise RuntimeError('the driver list couldn’t be read')
        if not st.get('supported'):
            raise RuntimeError('palOS’s NVIDIA driver runs GeForce RTX 20 series and newer graphics chips. This chip '
                               'keeps using palOS’s built-in graphics driver, which supports it.')
        v = st.get('version', '')
        return {'drivers': [{'pkg': 'nvidia-driver-' + v.split('.')[0], 'recommended': True, 'free': False,
                             'open': True, 'server': False, 'version': v}]}
    return _drv_job('scan', scan)


def a_drv_install(req):
    pkg = req.get('pkg') or 'auto'
    if pkg != 'auto' and not re.match(r'^nvidia-driver-\d+(-open|-server|-server-open)?$', pkg):
        return {'ok': False, 'error': 'not an NVIDIA driver'}

    def install():
        DRV['step'] = 'Installing the graphics driver'
        _store(['drivers-auto'] if pkg == 'auto' else ['drivers-install', pkg])
        open('/var/lib/palos-firstboot/drivers-installed', 'w').write(pkg + '\n')
        return {'installed': pkg}
    return _drv_job('install', install)


def a_drv_job(_):
    return dict(DRV)


# ------------------------------------------------------------------ language (setup for a new owner)
def a_set_language(req):
    """Any of palOS's languages, with a country or region: palos-locale makes the locale and picks the keyboard."""
    lang, region = str(req.get('language') or ''), str(req.get('region') or '')
    legacy = {'en-CA': ('en', 'CA'), 'fr-CA': ('fr', 'CA')}
    if lang in legacy:
        lang, region = legacy[lang]
    if not re.match(r'^[a-z]{2,3}(-[A-Z]{2})?$', lang) or (region and not re.match(r'^[A-Z]{2}$', region)):
        return {'ok': False, 'error': 'unknown language'}
    r = subprocess.run(['/usr/lib/palos-l10n/palos-locale', 'resolve', lang, region], capture_output=True, text=True)
    try:
        info = json.loads(r.stdout)
    except ValueError:
        return {'ok': False, 'error': 'unknown language'}
    loc, language = info['locale'], info['language']
    run(['/usr/lib/palos-l10n/palos-locale', 'build', loc])
    lay, var = info['keyboard']
    kb = req.get('keyboard') or (f'{lay}:{var}' if var else lay)
    os.makedirs('/var/lib/palos-firstboot', exist_ok=True)
    write_file('/var/lib/palos-firstboot/locale.conf',
               f'LANG={loc}\nLANGUAGE={language}\nLC_TIME={loc}\nLC_NUMERIC={loc}\nLC_MONETARY={loc}\nLC_PAPER={loc}\nLC_MEASUREMENT={loc}\nKEYBOARD={kb}\nPALOS_LANG={info["id"]}\nPALOS_REGION={info["region"]}\n')
    write_file('/etc/default/locale', f'LANG={loc}\nLANGUAGE={language}\n')
    l2, _, v2 = kb.partition(':')
    opts = 'grp:alt_shift_toggle' if ',' in l2 else ''
    try:
        write_file('/etc/default/keyboard', f'XKBMODEL="pc105"\nXKBLAYOUT="{l2}"\nXKBVARIANT="{v2}"\nXKBOPTIONS="{opts}"\nBACKSPACE="guess"\n')
    except OSError as e:
        log('keyboard:', e)
    open('/var/lib/palos-firstboot/language-chosen', 'w').write(f'{lang} {info["region"]}\n')
    return {'ok': True}


def a_finish(_):
    if not state['user']:
        return {'ok': False, 'error': 'Create your account first.'}
    # the login screen should offer the new person first
    try:
        lightdm = pwd.getpwnam('lightdm')
        f = os.path.join(lightdm.pw_dir, '.paladin-greeter-state')
        write_file(f, json.dumps({'user': state['user'], 'session': 'paladin'}), 0o600, lightdm.pw_uid, lightdm.pw_gid)
    except (KeyError, OSError) as e:
        log('greeter state:', e)
    try:
        TT.cleanup()
    except Exception as e:  # noqa: BLE001
        log('cleanup:', repr(e))
    run(['/usr/lib/palos-firstboot/disarm'])
    # straight to the desktop: the new account logs in once by itself (finish-switch takes this away again)
    try:
        write_file('/etc/lightdm/lightdm.conf.d/91-palos-first-login.conf',
                   f"# palOS: log the new account straight in after setup (removed right after)\n[Seat:*]\nautologin-user={state['user']}\nautologin-user-timeout=0\nautologin-session=paladin\ndisplay-setup-script=/usr/lib/palos-firstboot/blue-screen\n", 0o644)
    except OSError as e:
        log('first login:', e)
    # now the computer takes its new name (the login screen restarts in a moment, with the new name)
    if state.get('hostname'):
        try:
            set_hostname(state['hostname'], state.get('pretty'))
        except Exception as e:  # noqa: BLE001
            log('hostname:', repr(e))
    # Switch to the login screen a moment from now, outside this process (restarting LightDM ends the
    # setup session and stops this helper too).
    # a new graphics driver (the NVIDIA page) only starts with the computer: restart instead of going to the login screen
    how = ['reboot'] if os.path.exists('/var/lib/palos-firstboot/drivers-installed') else []
    r = run(['systemd-run', '--quiet', '--unit=palos-firstboot-finish', '--on-active=2', '--timer-property=AccuracySec=100ms',
             '/usr/lib/palos-firstboot/finish-switch'] + how)
    if r.returncode != 0:
        subprocess.Popen(['/bin/sh', '-c', 'sleep 2; exec /usr/lib/palos-firstboot/finish-switch'], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {'ok': True}


ACTIONS = {'status': a_status, 'check-user': a_check_user, 'camera': a_camera, 'wifi-connect': a_wifi_connect, 'wifi-radio': a_wifi_radio, 'wifi-rescan': a_wifi_rescan, 'create-user': a_create_user, 'appearance': a_appearance, 'finish': a_finish,
           'tt-scan': a_tt_scan, 'tt-open': a_tt_open, 'tt-inspect': a_tt_inspect, 'tt-restore': a_tt_restore,
           'tt-job': a_tt_job, 'tt-cancel': a_tt_cancel, 'tt-release': a_tt_release,
           'mig-scan': a_mig_scan, 'mig-copy': a_mig_copy, 'mig-job': a_mig_job, 'mig-release': a_mig_release,
           'gpu': a_gpu, 'drv-scan': a_drv_scan, 'drv-install': a_drv_install, 'drv-job': a_drv_job, 'set-language': a_set_language}


def serve():
    try:
        setup = pwd.getpwnam(SETUP_USER)
    except KeyError:
        log('no palos-setup user; nothing to do')
        return 1
    allowed = {setup.pw_uid}
    try:
        allowed.add(pwd.getpwnam('lightdm').pw_uid)
    except KeyError:
        pass
    os.makedirs(SOCK_DIR, exist_ok=True)
    os.chown(SOCK_DIR, 0, 0)
    os.chmod(SOCK_DIR, 0o755)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)          # who may talk to it is checked per connection, below
    srv.listen(4)
    log('ready')
    while os.path.exists(FLAG) or state['user']:
        conn, _ = srv.accept()
        with conn:
            try:
                creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
                _, uid, _ = struct.unpack('3i', creds)
                if uid not in allowed:
                    conn.sendall(b'{"ok":false,"error":"not allowed"}\n')
                    continue
                buf = b''
                conn.settimeout(10)
                while not buf.endswith(b'\n') and len(buf) < 8 * 1024 * 1024:
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    buf += chunk
                req = json.loads(buf.decode() or '{}')
                fn = ACTIONS.get(req.get('action'))
                res = fn(req) if fn else {'ok': False, 'error': 'unknown action'}
                if req.get('action') == 'create-user':
                    log('create-user', req.get('username'), '->', res.get('ok'))
                elif req.get('action') in ('tt-job', 'camera', 'drv-job', 'mig-job'):
                    pass
                else:
                    log(req.get('action'), '->', res.get('ok', True))
            except Exception as e:  # noqa: BLE001
                log('error:', repr(e))
                res = {'ok': False, 'error': str(e)}
            try:
                conn.sendall(json.dumps(res).encode() + b'\n')
            except OSError:
                pass
        if not os.path.exists(FLAG) and state['user']:
            time.sleep(0.2)
            break
    return 0


if __name__ == '__main__':
    os.environ['PATH'] = '/usr/sbin:/usr/bin:/sbin:/bin'
    ttrestore.set_logger(log)
    migrate.set_logger(log)
    if not os.path.exists(FLAG):
        log('first boot is done; not starting')
        sys.exit(0)
    sys.exit(serve())
