#!/usr/bin/python3
"""palOS Basic Setup: creates the first account when the full setup screen can't run on this computer.

It needs nothing but GTK 3 (the same as the login screen), draws without the graphics card, and talks to
the same root helper as the full setup screen. Wi-Fi, the picture and light or dark can be set later in
Settings."""
import json
import os
import re
import socket
import sys

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402
try:  # palOS: this program in the person's language
    import palos_l10n; palos_l10n.install_gtk(); _ = palos_l10n.tr
except Exception:  # noqa: BLE001
    _ = str

SOCK = '/run/palos-firstboot/helper.sock'
LOGO = ['/usr/share/palos/palos-logo-white.png', '/usr/share/icons/hicolor/256x256/apps/palos-logo.png']
USER_RE = re.compile(r'^[a-z][a-z0-9_-]{0,31}$')

CSS = b'''
* { font-family: "Noto Sans", sans-serif; }
window { background: linear-gradient(160deg, #2e4258, #16222f); }
.card { background: #f4f6f8; border-radius: 18px; padding: 34px 40px 28px 40px; }
.title { font-size: 22pt; font-weight: 600; color: #1b1e22; }
.lead { font-size: 11pt; color: #5b6470; }
.lbl { font-size: 10pt; color: #3a4048; }
entry { min-height: 34px; font-size: 11pt; border-radius: 8px; padding: 0 10px; background: #ffffff; color: #1b1e22;
        border: 1px solid #b9bfc7; box-shadow: none; }
entry:focus { border-color: #4c6278; box-shadow: 0 0 0 3px rgba(76,98,120,0.35); }
.go { background: #4c6278; color: #ffffff; border-radius: 8px; min-height: 36px; padding: 0 26px; font-weight: 600; border: none;
      box-shadow: none; text-shadow: none; }
.go:hover { background: #3d5164; }
.go:disabled { background: #9aa6b2; color: #eef0f2; }
.err { color: #a33a3a; font-size: 10pt; }
.hint { color: #7b8490; font-size: 9pt; }
'''


def helper(action, **data):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(120)
        s.connect(SOCK)
        s.sendall(json.dumps(dict(action=action, **data)).encode() + b'\n')
        buf = b''
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        s.close()
        return json.loads(buf.decode() or '{}')
    except (OSError, ValueError) as e:
        return {'ok': False, 'error': 'Setup’s helper isn’t answering (%s). Restart the computer and try again.' % e}


def suggest(full):
    first = (full.strip().split() or [''])[0].lower()
    u = re.sub(r'[^a-z0-9_-]', '', first)
    if u and not u[0].isalpha():
        u = 'u' + u
    return u[:32]


class Setup(Gtk.Window):
    def __init__(self):
        super().__init__(title='palOS Setup')
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Settings.get_default().set_property('gtk-cursor-theme-name', 'Paladin')
        self.set_decorated(False)
        scr = Gdk.Screen.get_default()
        self.set_default_size(scr.get_width(), scr.get_height())
        self.move(0, 0)
        self.fullscreen()
        self.connect('delete-event', lambda *_: True)    # setup can't be closed before it's done
        self.username_edited = False
        self.done = False

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, spacing=22)
        logo = None
        for p in LOGO:
            try:
                logo = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 112, 112, True))
                break
            except GLib.Error:
                continue
        if logo:
            outer.pack_start(logo, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class('card')
        card.set_size_request(440, -1)
        outer.pack_start(card, False, False, 0)
        self.card = card

        t = Gtk.Label(label='Create Your Account', xalign=0.5)
        t.get_style_context().add_class('title')
        card.pack_start(t, False, False, 0)
        lead = Gtk.Label(label='You’ll use this account to log in to palOS.\nWi-Fi, your picture and Dark Mode can be set later in Settings.',
                         xalign=0.5, justify=Gtk.Justification.CENTER, margin_bottom=14)
        lead.get_style_context().add_class('lead')
        card.pack_start(lead, False, False, 0)

        self.full = self.field(card, 'Full name')
        self.user = self.field(card, 'Account name')
        h = Gtk.Label(label='Lowercase letters and numbers. It’s also the name of your home folder.', xalign=0)
        h.get_style_context().add_class('hint')
        card.pack_start(h, False, False, 0)
        self.pw = self.field(card, 'Password', secret=True)
        self.pw2 = self.field(card, 'Verify password', secret=True)

        self.err = Gtk.Label(xalign=0.5, wrap=True, max_width_chars=48, margin_top=8)
        self.err.get_style_context().add_class('err')
        card.pack_start(self.err, False, False, 0)
        row = Gtk.Box(halign=Gtk.Align.END, margin_top=12)
        self.go = Gtk.Button(label='Create Account')
        self.go.get_style_context().add_class('go')
        self.go.connect('clicked', self.create)
        row.pack_end(self.go, False, False, 0)
        card.pack_start(row, False, False, 0)

        self.full.connect('changed', self.on_full)
        self.user.connect('changed', lambda e: setattr(self, 'username_edited', True) if e.has_focus() else None)
        for e in (self.full, self.user, self.pw, self.pw2):
            e.connect('activate', self.create)
        self.add(outer)
        self.show_all()
        self.full.grab_focus()
        GLib.idle_add(self.check_helper)

    def field(self, box, label, secret=False):
        lb = Gtk.Label(label=label, xalign=0, margin_top=8)
        lb.get_style_context().add_class('lbl')
        box.pack_start(lb, False, False, 0)
        e = Gtk.Entry(visibility=not secret)
        e.set_activates_default(False)
        box.pack_start(e, False, False, 0)
        return e

    def check_helper(self):
        r = helper('status')
        if 'error' in r and r.get('ok') is False:
            self.err.set_text(r['error'])
        elif r.get('user'):
            # the account was made before the setup screen stopped: only finishing is left
            self.done = True
            for e in (self.full, self.user, self.pw, self.pw2):
                e.set_sensitive(False)
            self.full.set_text(r.get('fullname') or r['user'])
            self.user.set_text(r['user'])
            self.go.set_sensitive(False)
            self.go.set_label('Starting palOS…')
            fin = helper('finish')
            if not fin.get('ok'):
                self.err.set_text(fin.get('error') or 'Setup couldn’t finish. Restart the computer to log in.')
            GLib.timeout_add_seconds(20, Gtk.main_quit)
        return False

    def on_full(self, e):
        if not self.username_edited:
            self.user.set_text(suggest(e.get_text()))

    def create(self, *_):
        if self.done:
            return
        full = self.full.get_text().strip()
        user = self.user.get_text().strip()
        pw, pw2 = self.pw.get_text(), self.pw2.get_text()
        if not full:
            return self.fail('Enter your name.', self.full)
        if not USER_RE.match(user):
            return self.fail('Use lowercase letters, numbers, - and _ for the account name, starting with a letter.', self.user)
        if not pw:
            return self.fail('Choose a password.', self.pw)
        if pw != pw2:
            return self.fail('The passwords don’t match.', self.pw2)
        r = helper('check-user', username=user)
        if not r.get('ok'):
            return self.fail(r.get('error') or 'That account name can’t be used.', self.user)
        self.err.set_text('')
        self.go.set_sensitive(False)
        self.go.set_label('Creating…')
        GLib.idle_add(self.really_create, full, user, pw)

    def really_create(self, full, user, pw):
        r = helper('create-user', fullname=full, username=user, password=pw, dark=False)
        if not r.get('ok'):
            self.go.set_sensitive(True)
            self.go.set_label('Create Account')
            self.fail(r.get('error') or 'The account couldn’t be created.', self.user)
            return False
        self.done = True
        self.go.set_label('Starting palOS…')
        r = helper('finish')
        if not r.get('ok'):
            self.err.set_text(r.get('error') or 'Setup couldn’t finish. Restart the computer to log in.')
        GLib.timeout_add_seconds(20, Gtk.main_quit)    # the helper switches to the login screen
        return False

    def fail(self, msg, widget):
        self.err.set_text(msg)
        widget.grab_focus()


def main():
    if not os.path.exists('/var/lib/palos/firstboot'):
        return 0
    Setup()
    Gtk.main()
    return 0


if __name__ == '__main__':
    sys.exit(main())
