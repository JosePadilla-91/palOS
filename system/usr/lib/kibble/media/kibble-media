#!/usr/bin/python3 -I
"""kibble-media: Kibble's media engine (one for each Kibble app, started by its runtime when a page first plays).

Pages keep using <video> and <audio>; Kibble's page side turns those into commands for this process:
  - sound plays straight into palOS's sound system (PipeWire), named after the app, so the sound router and the
    volume controls treat it like any other app;
  - video is decoded here (the graphics chip's decoder when there is one) and each picture is handed to the page
    as it should be shown, over a private address on this computer only (127.0.0.1, with a random key).

Commands come in on stdin, one JSON object per line ({"op": "load", "pid": 1, "uri": ...}); events go out on
stdout the same way ({"pid": 1, "ev": "time", "t": 12.3}). It ends when its app ends (stdin closes).
"""
import json, os, secrets, sys, threading
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler

import gi
gi.require_version('Gst', '1.0')
from gi.repository import Gst, GLib

Gst.init(None)
APP = os.environ.get('KIBBLE_MEDIA_APP') or 'Kibble'
TOKEN = secrets.token_hex(16)
NS = Gst.SECOND
FLAG_VIDEO, FLAG_AUDIO, FLAG_TEXT, FLAG_SOFT_VOLUME = 0x1, 0x2, 0x4, 0x10

_out = threading.Lock()


def emit(**m):
    with _out:
        try:
            sys.stdout.write(json.dumps(m) + '\n'); sys.stdout.flush()
        except (BrokenPipeError, ValueError):
            os._exit(0)


def log(msg):
    sys.stderr.write(f'kibble-media: {msg}\n'); sys.stderr.flush()


# ---------------------------------------------------------------- pictures, for the page
class Frames:
    """the newest picture of one player (JPEG), for whoever is showing it"""
    def __init__(self):
        self.cv = threading.Condition(); self.jpeg = None; self.n = 0; self.closed = False
        self.served = {}                     # viewer -> the newest picture it has

    def put(self, data):
        with self.cv:
            self.jpeg = data; self.n += 1; self.cv.notify_all()

    def close(self):
        with self.cv:
            self.closed = True; self.cv.notify_all()


frames = {}


class Http(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, *a):
        pass

    def _frames(self, kind):
        parts = self.path.split('?')[0].strip('/').split('/')
        if len(parts) != 3 or parts[0] != kind or parts[1] != TOKEN:
            return None
        try:
            return frames.get(int(parts[2].split('.')[0]))
        except ValueError:
            return None

    def do_GET(self):
        if self.path.startswith('/n/'):                 # the next picture this viewer hasn't had (waits for it)
            parts = self.path.split('?')[0].strip('/').split('/')
            f = None
            if len(parts) == 5 and parts[1] == TOKEN:
                try:
                    f = frames.get(int(parts[2]))
                except ValueError:
                    f = None
            if not f:
                self.send_error(404); return
            viewer = parts[3][:40]
            with f.cv:
                last = f.served.get(viewer, 0)
                if f.n <= last and not f.closed:
                    f.cv.wait(1.5)
                if f.closed:
                    data = None; gone = True
                else:
                    gone = False
                    data = f.jpeg if f.n > last else None
                    if data is not None:
                        f.served[viewer] = f.n
            if gone:
                self.send_error(404); return
            if data is None:
                self.send_response(204)
                self.send_header('Access-Control-Allow-Origin', '*'); self.send_header('Content-Length', '0'); self.end_headers(); return
            self.send_response(200)
            for k, v in (('Content-Type', 'image/jpeg'), ('Content-Length', str(len(data))), ('Cache-Control', 'no-store'),
                         ('Access-Control-Allow-Origin', '*')):
                self.send_header(k, v)
            self.end_headers(); self.wfile.write(data); return
        if self.path.startswith('/f/'):                 # one picture (a still, for drawing on a canvas)
            f = self._frames('f')
            if not f or f.jpeg is None:
                self.send_error(404); return
            data = f.jpeg
            self.send_response(200)
            for k, v in (('Content-Type', 'image/jpeg'), ('Content-Length', str(len(data))), ('Cache-Control', 'no-store'),
                         ('Access-Control-Allow-Origin', '*')):
                self.send_header(k, v)
            self.end_headers(); self.wfile.write(data); return
        f = self._frames('v')                          # the moving picture: each new frame as it arrives
        if not f:
            self.send_error(404); return
        self.send_response(200)
        for k, v in (('Content-Type', 'multipart/x-mixed-replace; boundary=kibbleframe'), ('Cache-Control', 'no-store'),
                     ('Access-Control-Allow-Origin', '*'), ('Connection', 'close')):
            self.send_header(k, v)
        self.end_headers()
        seen = -1
        try:
            while True:
                with f.cv:
                    if f.n == seen and not f.closed:
                        f.cv.wait(2.0)
                    if f.closed:
                        break
                    if f.n == seen or f.jpeg is None:
                        continue
                    seen, data = f.n, f.jpeg
                self.wfile.write(b'--kibbleframe\r\nContent-Type: image/jpeg\r\nContent-Length: %d\r\n\r\n' % len(data))
                self.wfile.write(data); self.wfile.write(b'\r\n'); self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass


# ---------------------------------------------------------------- players
def audio_sink(role):
    """palOS's sound system, named after the app; anything else that can play sound if it isn't answering"""
    if os.environ.get('KIBBLE_MEDIA_AUDIO_SINK'):           # for testing: another output (fakesink, alsasink...)
        return Gst.parse_bin_from_description(os.environ['KIBBLE_MEDIA_AUDIO_SINK'], True)
    s = Gst.ElementFactory.make('pulsesink', None)
    if s is not None:
        try:
            s.set_property('client-name', APP)
            st = Gst.Structure.new_from_string(f'props, media.role=(string){role}, application.name=(string)"{APP}"')
            if st:
                s.set_property('stream-properties', st)
        except Exception:
            pass
        if s.set_state(Gst.State.READY) != Gst.StateChangeReturn.FAILURE:
            s.set_state(Gst.State.NULL)
            return s
        s.set_state(Gst.State.NULL)
    return Gst.ElementFactory.make('autoaudiosink', None)


class Player:
    def __init__(self, pid, m):
        self.pid = pid
        self.video = bool(m.get('video'))
        self.loop = bool(m.get('loop'))
        self.rate = 1.0
        self.want_play = False
        self.meta_sent = False
        self.first_frame = False
        self.seeking = False
        self.src_size = None
        self.uri = m.get('uri')
        self.silent = False                  # playing without sound (the sound system never answered)
        self.loaded_at = GLib.get_monotonic_time()
        self.last_pos, self.still_since = None, GLib.get_monotonic_time()
        self.camera = bool(m.get('camera'))
        self.failed = False
        self.m = dict(m)
        self.pending_seek = None
        self.frames = frames.setdefault(pid, Frames())
        if self.camera:
            self._camera(m)
        else:
            self._playbin(m)
        bus = self.pipe.get_bus(); bus.add_signal_watch(); self.bus_id = bus.connect('message', self._bus)
        self.tick = GLib.timeout_add(250, self._tick)

    def _video_bin(self):
        b = Gst.parse_bin_from_description(
            'videoconvert ! videoscale ! capsfilter name=cf caps=video/x-raw ! jpegenc quality=85 ! '
            'appsink name=snk emit-signals=true max-buffers=1 drop=true sync=true', True)
        snk = b.get_by_name('snk')
        snk.connect('new-sample', self._sample, 'pull-sample')
        snk.connect('new-preroll', self._sample, 'pull-preroll')
        self.cf = b.get_by_name('cf')
        return b

    def _playbin(self, m, silent=False):
        self.pipe = Gst.ElementFactory.make('playbin', None)
        self.pipe.set_property('uri', m['uri'])
        flags = FLAG_AUDIO | FLAG_SOFT_VOLUME | (FLAG_VIDEO if self.video else 0)
        self.pipe.set_property('flags', flags)
        if silent:
            sink = Gst.ElementFactory.make('fakesink', None); sink.set_property('sync', True)
        else:
            sink = audio_sink('Movie' if self.video else 'Music')
        self.pipe.set_property('audio-sink', sink)
        if self.video:
            self.pipe.set_property('video-sink', self._video_bin())
        self.pipe.set_property('volume', max(0.0, min(1.0, float(m.get('volume', 1.0)))))
        self.pipe.set_property('mute', bool(m.get('muted')))
        self.pipe.set_state(Gst.State.PAUSED)          # loads it, and shows its first picture

    def _camera(self, m):
        src = 'pipewiresrc' if Gst.ElementFactory.find('pipewiresrc') and m.get('pipewire') else 'v4l2src'
        dev = m.get('device')
        src_desc = os.environ.get('KIBBLE_MEDIA_CAMERA_SRC') or f'{src}{" device=" + dev if dev and src == "v4l2src" else ""}'   # (testing: another source)
        desc = f'{src_desc} ! decodebin ! videoconvert ! videoscale ! ' \
               'capsfilter name=cf caps=video/x-raw,width=1280,height=720;video/x-raw ! jpegenc quality=85 ! ' \
               'appsink name=snk emit-signals=true max-buffers=1 drop=true sync=false'
        self.pipe = Gst.parse_launch(desc)
        snk = self.pipe.get_by_name('snk'); snk.connect('new-sample', self._sample, 'pull-sample')
        self.cf = self.pipe.get_by_name('cf')
        self.want_play = True
        self.pipe.set_state(Gst.State.PLAYING)

    # a new picture (streaming thread)
    def _sample(self, snk, how):
        s = snk.emit(how)
        if s is None:
            return Gst.FlowReturn.OK
        buf = s.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if ok:
            try:
                self.frames.put(bytes(info.data))
            finally:
                buf.unmap(info)
        if not self.first_frame:
            self.first_frame = True
            st = s.get_caps().get_structure(0)
            w, h = st.get_value('width'), st.get_value('height')
            if not self.src_size:
                self.src_size = (w, h)
            GLib.idle_add(lambda: emit(pid=self.pid, ev='frame', width=self.src_size[0], height=self.src_size[1]) and False)
        return Gst.FlowReturn.OK

    def _source_size(self):
        try:
            pad = self.pipe.emit('get-video-pad', 0)
            caps = pad.get_current_caps() if pad else None
            if caps:
                st = caps.get_structure(0)
                return st.get_value('width'), st.get_value('height')
        except Exception:
            pass
        return None

    def _meta(self):
        if self.meta_sent:
            return
        self.meta_sent = True
        ok, dur = self.pipe.query_duration(Gst.Format.TIME)
        nv = self.pipe.get_property('n-video') if not self.camera else 1
        na = self.pipe.get_property('n-audio') if not self.camera else 0
        size = self._source_size() if nv else None
        if size:
            self.src_size = size
        emit(pid=self.pid, ev='meta', duration=(dur / NS) if ok and dur >= 0 else None, hasVideo=bool(nv), hasAudio=bool(na),
             width=size[0] if size else 0, height=size[1] if size else 0, seekable=ok and dur > 0)

    def _bus(self, bus, msg):
        t = msg.type
        if t == Gst.MessageType.ASYNC_DONE:
            self._meta()
            if self.pending_seek is not None:
                at, self.pending_seek = self.pending_seek, None
                self.seek(at)
                return True
            if self.seeking:
                self.seeking = False
                emit(pid=self.pid, ev='seeked', t=self._pos())
        elif t == Gst.MessageType.DURATION_CHANGED:
            ok, dur = self.pipe.query_duration(Gst.Format.TIME)
            if ok and dur >= 0:
                emit(pid=self.pid, ev='duration', duration=dur / NS)
        elif t == Gst.MessageType.STATE_CHANGED and msg.src == self.pipe:
            old, new, _ = msg.parse_state_changed()
            if new == Gst.State.PLAYING:
                emit(pid=self.pid, ev='playing', t=self._pos())
            elif new == Gst.State.PAUSED and old == Gst.State.PLAYING:
                emit(pid=self.pid, ev='paused', t=self._pos())
        elif t == Gst.MessageType.EOS:
            if self.loop:
                self.pipe.seek_simple(Gst.Format.TIME, Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT, 0)
            else:
                self.want_play = False
                self.pipe.set_state(Gst.State.PAUSED)
                emit(pid=self.pid, ev='ended', t=self._pos())
        elif t == Gst.MessageType.ERROR:
            err, dbg = msg.parse_error()
            log(f'{self.pid}: {err.message} ({dbg})')
            code = 4 if err.domain in ('gst-stream-error-quark',) or 'not-negotiated' in str(dbg) or 'decode' in err.message.lower() else 2
            if 'Resource not found' in err.message or 'Could not open' in err.message or err.domain == 'gst-resource-error-quark':
                code = 4 if 'not found' in err.message.lower() else 2
            self.failed = True; self.want_play = False
            emit(pid=self.pid, ev='error', code=code, message=err.message)
            self.pipe.set_state(Gst.State.NULL)
        elif t == Gst.MessageType.BUFFERING:
            pct = msg.parse_buffering()
            if self.want_play:
                self.pipe.set_state(Gst.State.PLAYING if pct >= 100 else Gst.State.PAUSED)
            emit(pid=self.pid, ev='buffering', percent=pct)
        return True

    def _pos(self):
        ok, pos = self.pipe.query_position(Gst.Format.TIME)
        return pos / NS if ok and pos >= 0 else None

    def _tick(self):
        now = GLib.get_monotonic_time()
        if self.want_play:
            p = self._pos()
            if p is not None:
                emit(pid=self.pid, ev='time', t=p)
            if p != self.last_pos or self.seeking:
                self.last_pos, self.still_since = p, now
        else:
            self.still_since = now
        # a sound output that never takes the sound holds the whole film still: carry on without sound rather
        # than freeze (a computer with no sound at all, or the sound system not running)
        if not self.camera and not self.silent and not self.failed and (
                (not self.meta_sent and now - self.loaded_at > 5_000_000) or
                (self.want_play and self.meta_sent and now - self.still_since > 4_000_000)):
            self._go_silent()
        return True

    def _go_silent(self):
        """a new pipeline without sound, from the same moment; the stuck one is shut down out of the way"""
        self.silent = True
        pos = self.last_pos or 0.0
        log(f'{self.pid}: the sound output isn\'t taking any sound; playing on without it, from {pos:.2f}s')
        emit(pid=self.pid, ev='silent', t=pos)
        old = self.pipe
        try:
            vol, mute = old.get_property('volume'), old.get_property('mute')
        except Exception:
            vol, mute = 1.0, False
        bus = old.get_bus(); bus.disconnect(self.bus_id); bus.remove_signal_watch()
        threading.Thread(target=lambda: old.set_state(Gst.State.NULL), daemon=True).start()
        m = dict(self.m, volume=vol, muted=mute)
        self.meta_sent = False; self.first_frame = False
        self.pending_seek = pos if pos > 0.05 else None
        self._playbin(m, silent=True)
        bus = self.pipe.get_bus(); bus.add_signal_watch(); self.bus_id = bus.connect('message', self._bus)
        if self.want_play:
            self.pipe.set_state(Gst.State.PLAYING)
        self.still_since = GLib.get_monotonic_time()

    def play(self):
        self.want_play = True
        self.pipe.set_state(Gst.State.PLAYING)

    def pause(self):
        self.want_play = False
        self.pipe.set_state(Gst.State.PAUSED)

    def seek(self, t):
        self.seeking = True
        flags = Gst.SeekFlags.FLUSH | Gst.SeekFlags.ACCURATE
        if self.rate == 1.0:
            self.pipe.seek_simple(Gst.Format.TIME, flags, int(max(0.0, t) * NS))
        else:
            self.pipe.seek(self.rate, Gst.Format.TIME, flags, Gst.SeekType.SET, int(max(0.0, t) * NS), Gst.SeekType.NONE, -1)

    def set_rate(self, r):
        r = float(r) or 1.0
        if r == self.rate:
            return
        self.rate = r
        pos = self._pos() or 0.0
        self.pipe.seek(r, Gst.Format.TIME, Gst.SeekFlags.FLUSH | Gst.SeekFlags.ACCURATE, Gst.SeekType.SET, int(pos * NS), Gst.SeekType.NONE, -1)

    def volume(self, v, muted):
        if v is not None:
            self.pipe.set_property('volume', max(0.0, min(1.0, float(v))))
        if muted is not None:
            self.pipe.set_property('mute', bool(muted))

    def size(self, w, h):
        """pictures no bigger than they're shown (less work for big films in small places)"""
        if not self.src_size or not getattr(self, 'cf', None) or self.camera:
            return
        sw, sh = self.src_size
        w, h = int(w or 0), int(h or 0)
        if w <= 0 or h <= 0 or (w * 1.2 >= sw and h * 1.2 >= sh):
            caps = 'video/x-raw'
        else:
            k = min(w / sw, h / sh)
            nw, nh = max(2, int(sw * k) // 2 * 2), max(2, int(sh * k) // 2 * 2)
            caps = f'video/x-raw,width={nw},height={nh},pixel-aspect-ratio=1/1'
        self.cf.set_property('caps', Gst.Caps.from_string(caps))

    def destroy(self):
        try:
            GLib.source_remove(self.tick)
        except Exception:
            pass
        self.pipe.set_state(Gst.State.NULL)
        bus = self.pipe.get_bus(); bus.disconnect(self.bus_id); bus.remove_signal_watch()
        f = frames.pop(self.pid, None)
        if f:
            f.close()


players = {}


def handle(m):
    op, pid = m.get('op'), m.get('pid')
    try:
        if op == 'load':
            if pid in players:
                players.pop(pid).destroy()
            p = players[pid] = Player(pid, m)
            if m.get('play'):
                p.play()
        elif op == 'destroy':
            if pid in players:
                players.pop(pid).destroy()
        elif pid in players:
            p = players[pid]
            if op == 'play':
                p.play()
            elif op == 'pause':
                p.pause()
            elif op == 'seek':
                p.seek(float(m.get('t') or 0))
            elif op == 'rate':
                p.set_rate(m.get('rate', 1))
            elif op == 'volume':
                p.volume(m.get('volume'), m.get('muted'))
            elif op == 'loop':
                p.loop = bool(m.get('loop'))
            elif op == 'size':
                p.size(m.get('width'), m.get('height'))
    except Exception as e:
        log(f'{op} {pid}: {e}')
        emit(pid=pid, ev='error', code=4, message=str(e))
    return False


def read_stdin(loop):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            m = json.loads(line)
        except ValueError:
            continue
        GLib.idle_add(handle, m)
    GLib.idle_add(loop.quit)


def main():
    srv = ThreadingHTTPServer(('127.0.0.1', 0), Http)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    loop = GLib.MainLoop()
    threading.Thread(target=read_stdin, args=(loop,), daemon=True).start()
    emit(ev='ready', port=srv.server_address[1], token=TOKEN)
    try:
        loop.run()
    finally:
        for p in list(players.values()):
            p.destroy()
        srv.shutdown()


if __name__ == '__main__':
    main()
