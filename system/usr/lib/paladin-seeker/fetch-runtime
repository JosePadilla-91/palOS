#!/usr/bin/python3
"""Install the Electron runtime that Seeker runs on.

Seeker's package carries only Seeker itself; the matching Electron build (about 110 MB)
is downloaded once from the official Electron releases on GitHub and checked against
a fixed SHA-256 checksum before it is installed.

Offline install: put the zip named in /usr/lib/paladin-seeker/runtime.json into
/var/cache/paladin-seeker/ before installing the package (or run this script with
--zip /path/to/the.zip). The checksum is verified either way.
"""
import hashlib
import json
import os
import shutil
import stat
import sys
import tempfile
import urllib.request
import zipfile

CFG = json.load(open('/usr/lib/paladin-seeker/runtime.json'))
BASE = '/opt/paladin-seeker'
DEST = os.path.join(BASE, 'runtime')
CACHE = '/var/cache/paladin-seeker'
MARK = os.path.join(DEST, '.paladin-runtime')


def say(msg):
    print(f'paladin-seeker: {msg}', flush=True)


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def download(url, out):
    say(f'downloading Electron {CFG["version"]} (about {CFG["size_mb"]} MB)…')
    req = urllib.request.Request(url, headers={'User-Agent': 'paladin-seeker-installer'})
    with urllib.request.urlopen(req, timeout=60) as r, open(out + '.part', 'wb') as f:
        total = int(r.headers.get('Content-Length') or 0)
        done = 0
        last = -1
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)
            done += len(chunk)
            if total:
                pct = done * 100 // total
                if pct // 10 != last:
                    last = pct // 10
                    say(f'  {pct}%')
    os.replace(out + '.part', out)


def extract(zip_path, target):
    with zipfile.ZipFile(zip_path) as z:
        for info in z.infolist():
            path = z.extract(info, target)
            mode = (info.external_attr >> 16) & 0o777
            if mode:
                os.chmod(path, mode)


def main():
    if os.geteuid() != 0:
        say('run this as root (sudo).')
        return 1
    zip_arg = None
    if '--zip' in sys.argv:
        zip_arg = sys.argv[sys.argv.index('--zip') + 1]
    force = '--force' in sys.argv
    if not force and os.path.exists(MARK) and open(MARK).read().strip() == CFG['sha256']:
        say(f'Electron {CFG["version"]} is already installed.')
        link_app()
        run_hooks()
        return 0
    os.makedirs(CACHE, exist_ok=True)
    zip_path = zip_arg or os.path.join(CACHE, CFG['file'])
    if not (os.path.exists(zip_path) and sha256(zip_path) == CFG['sha256']):
        if zip_arg:
            say(f'{zip_arg} does not match the expected checksum.')
            return 1
        try:
            download(CFG['url'], zip_path)
        except Exception as e:  # noqa: BLE001
            say(f'could not download the Electron runtime: {e}')
            say('Connect to the internet and run:  sudo dpkg --configure -a')
            say(f'or download {CFG["url"]}')
            say(f'put it in {CACHE}/ and run:  sudo dpkg --configure -a')
            return 1
        got = sha256(zip_path)
        if got != CFG['sha256']:
            os.unlink(zip_path)
            say(f'checksum mismatch (got {got}); the download was rejected.')
            return 1
    say('installing the runtime…')
    tmp = tempfile.mkdtemp(prefix='.runtime-', dir=BASE)
    try:
        extract(zip_path, tmp)
        sandbox = os.path.join(tmp, 'chrome-sandbox')
        if os.path.exists(sandbox):
            os.chown(sandbox, 0, 0)
            os.chmod(sandbox, 0o4755)
        for name in ('electron', 'chrome_crashpad_handler'):
            p = os.path.join(tmp, name)
            if os.path.exists(p):
                os.chmod(p, 0o755)
        default_app = os.path.join(tmp, 'resources', 'default_app.asar')
        if os.path.exists(default_app):
            os.unlink(default_app)
        with open(os.path.join(tmp, '.paladin-runtime'), 'w') as f:
            f.write(CFG['sha256'] + '\n')
        os.chmod(tmp, 0o755)
        old = DEST + '.old'
        if os.path.exists(DEST):
            shutil.rmtree(old, ignore_errors=True)
            os.rename(DEST, old)
        os.rename(tmp, DEST)
        shutil.rmtree(old, ignore_errors=True)
    except Exception:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    link_app()
    run_hooks()
    # Keep the cache small: the zip is only needed to reinstall offline.
    for f in os.listdir(CACHE):
        if f.endswith('.part') or (f.startswith('electron-') and f != CFG['file']):
            os.unlink(os.path.join(CACHE, f))
    say(f'Electron {CFG["version"]} installed.')
    return 0


def run_hooks():
    """Other Paladin apps that run on this runtime (Paladin Settings) set up their own link to it."""
    d = '/usr/lib/paladin-seeker/runtime-hooks.d'
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return
    import subprocess
    for n in names:
        p = os.path.join(d, n)
        if os.access(p, os.X_OK) and os.path.isfile(p):
            subprocess.run([p], check=False)


def link_app():
    """Make the runtime start Seeker directly (resources/app -> /opt/paladin-seeker/app)."""
    link = os.path.join(DEST, 'resources', 'app')
    if os.path.islink(link) and os.readlink(link) == os.path.join(BASE, 'app'):
        return
    if os.path.lexists(link):
        if os.path.isdir(link) and not os.path.islink(link):
            shutil.rmtree(link)
        else:
            os.unlink(link)
    os.symlink(os.path.join(BASE, 'app'), link)
    st = os.stat(DEST)
    os.chmod(DEST, st.st_mode | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)


if __name__ == '__main__':
    sys.exit(main())
