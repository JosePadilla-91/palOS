#!/usr/bin/python3
"""Change the calling user's own password with passwd, answering its prompts on a pseudo-terminal.
Reads the current password and the new one (one per line) from standard input."""
import os
import pty
import re
import select
import signal
import sys
import time

old = sys.stdin.readline().rstrip('\n')
new = sys.stdin.readline().rstrip('\n')
if not new:
    print('The new password is empty.')
    sys.exit(2)

pid, fd = pty.fork()
if pid == 0:
    os.environ['LC_ALL'] = 'C'
    os.execvp('passwd', ['passwd'])

buf = b''
seen = ''
answered = {'current': False, 'new': 0}
problem = None


def send(text):
    os.write(fd, text.encode() + b'\n')


deadline = time.time() + 25
while time.time() < deadline:
    r, _, _ = select.select([fd], [], [], 0.5)
    if not r:
        continue
    try:
        chunk = os.read(fd, 1024)
    except OSError:
        break
    if not chunk:
        break
    buf += chunk
    text = buf.decode(errors='replace')
    seen += chunk.decode(errors='replace')
    tail = text.lower()[-200:]
    bad = re.search(r'BAD PASSWORD: *([^\r\n]+)', text) or re.search(r'(You must choose a [^\r\n]+|[^\r\n]*(?:too short|too simple|too similar|palindrome|dictionary)[^\r\n]*)', text, re.I)
    if bad and answered['new']:
        problem = bad.group(1).strip()
    if re.search(r'current.*password:\s*$', tail) and not answered['current']:
        answered['current'] = True
        send(old)
        buf = b''
    elif re.search(r'(new|retype).*password:\s*$', tail):
        if problem or answered['new'] >= 2:
            break           # passwd is asking again: the new password was refused
        answered['new'] += 1
        send(new)
        buf = b''

done_pid, status = os.waitpid(pid, os.WNOHANG)
for _ in range(10):
    if done_pid:
        break
    time.sleep(0.2)
    done_pid, status = os.waitpid(pid, os.WNOHANG)
if not done_pid:              # passwd is still waiting for a better password: stop it
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    _, status = os.waitpid(pid, 0)
code = os.waitstatus_to_exitcode(status) if os.WIFEXITED(status) else 1
low = seen.lower()
if code != 0 or problem:
    if problem:
        p = problem.rstrip('.')
        msg = ('Choose a longer new password.' if re.search(r'longer|too short', p, re.I) else 'Choose a stronger new password (' + p[0].lower() + p[1:] + ').')
    elif answered['current'] and answered['new'] == 0:
        msg = 'The current password is not right.'
    elif 'authentication token manipulation' in low or 'authentication failure' in low:
        msg = 'The current password is not right.'
    else:
        lines = [m.strip() for m in seen.splitlines() if m.strip() and 'password:' not in m.lower()]
        msg = lines[-1] if lines else 'The password was not changed.'
    print(msg)
    sys.exit(code or 1)
sys.exit(0)
