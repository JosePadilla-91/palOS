#!/bin/sh
# Paladin Dock launcher. The Dock can't be quit: whenever it stops (a crash, or "killall dock" in Terminal),
# it comes straight back, the way a Mac's Dock does. It ends only with the session.
# The Dock's process is named "dock" (that's what "killall dock" finds). It runs on Kibble.
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/paladin-dock"
LOG="$LOG_DIR/paladin-dock.log"
mkdir -p "$LOG_DIR"
[ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 524288 ] && mv -f "$LOG" "$LOG.old"
[ -n "$DISPLAY" ] || { echo "Paladin Dock needs an X11 session." >&2; exit 3; }

# one Dock per display
LOCK="${XDG_RUNTIME_DIR:-$LOG_DIR}/paladin-dock$(echo "$DISPLAY" | tr ':/' '__').lock"
exec 9>"$LOCK"
if command -v flock >/dev/null && ! flock -n 9; then echo "Paladin Dock is already running." >&2; exit 0; fi

# Kibble's Node, under the name "dock"
NODE=/usr/lib/kibble/node/bin/node
[ -x /usr/lib/paladin-dock/dock ] && NODE=/usr/lib/paladin-dock/dock

# the Dock keeps its own size (Dock settings: icon size, magnification); Settings → Displays → Scale is for apps.
# A scaled Dock would be drawn off the bottom of the screen (it lays itself out in screen pixels).
export PALOS_SCALE=1

session_over() { command -v xdpyinfo >/dev/null && ! xdpyinfo >/dev/null 2>&1; }

fails=0; window_start=$(date +%s)
while :; do
  echo "$(date '+%F %T') starting Paladin Dock" >> "$LOG"
  KIBBLE_NODE="$NODE" PALOS_APP_DIR=/usr/lib/paladin-dock/app /usr/lib/kibble/kibble "$@" 9>&- >> "$LOG" 2>&1
  code=$?
  session_over && exit 0
  now=$(date +%s)
  if [ $((now - window_start)) -gt 60 ]; then fails=0; window_start=$now; fi
  fails=$((fails + 1))
  echo "$(date '+%F %T') Paladin Dock stopped (exit code $code); starting it again" >> "$LOG"
  # quick stops in a row: wait a little longer each time (never gives up)
  if [ "$fails" -ge 5 ]; then sleep 10; else sleep 0.3; fi
done
