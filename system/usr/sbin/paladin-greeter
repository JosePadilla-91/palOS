#!/bin/sh
# Paladin login screen (on Kibble). If it can't start (or quits straight away), it starts once more with
# plain software drawing (a graphics driver problem is the usual cause), so there is always a way to log in.
export XCURSOR_THEME=Paladin XCURSOR_SIZE=24 NO_AT_BRIDGE=1 PALOS_NO_THEME=1
export HOME="${HOME:-/var/lib/paladin-login}" XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/var/lib/paladin-login/.config}"
command -v palos-x >/dev/null 2>&1 && palos-x numlock on
# the display scale the last person chose (Settings → Displays) suits the login screen too
export PALOS_SCALE=1   # the login screen is laid out for the screen as it is
START=$(date +%s)
# paladin-login ends the login screen with SIGTERM once the session starts: pass it on, so the login screen's
# window never stays on top of the desktop (that looked like a frozen login)
/usr/lib/kibble/kibble /usr/share/paladin-greeter/app &
PID=$!
trap 'kill -TERM $PID 2>/dev/null; sleep 1; kill -KILL $PID 2>/dev/null; exit 0' TERM INT HUP
wait $PID
CODE=$?
trap - TERM INT HUP
[ "$CODE" -eq 0 ] && exit 0
logger -t paladin-greeter "the login screen stopped (code $CODE)" 2>/dev/null || true
if [ $(( $(date +%s) - START )) -lt 30 ]; then
  # A computer that has no account yet can't use a plain login screen: run setup instead.
  if [ -e /var/lib/palos/firstboot ] && ! awk -F: '$3 >= 1000 && $3 < 60000 { found = 1 } END { exit !found }' /etc/passwd; then
    PALOS_SETUP_FROM="login screen launcher" /usr/lib/palos-firstboot/run-setup
    [ -e /var/lib/palos/firstboot ] || exit 0
  fi
  echo "paladin-greeter: starting the login screen again with software drawing" >&2
  LIBGL_ALWAYS_SOFTWARE=1 KIBBLE_NO_DRI3=1 /usr/lib/kibble/kibble /usr/share/paladin-greeter/app &
  PID=$!
  trap 'kill -TERM $PID 2>/dev/null; sleep 1; kill -KILL $PID 2>/dev/null; exit 0' TERM INT HUP
  wait $PID
  CODE=$?
fi
exit "$CODE"
