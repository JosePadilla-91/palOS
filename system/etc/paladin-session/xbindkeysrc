# Paladin session keys (xbindkeys). Add your own in ~/.xbindkeysrc.
"/usr/lib/paladin-session/paladin-session-helper key volume-up"
  XF86AudioRaiseVolume
"/usr/lib/paladin-session/paladin-session-helper key volume-down"
  XF86AudioLowerVolume
"/usr/lib/paladin-session/paladin-session-helper key mute"
  XF86AudioMute
"/usr/lib/paladin-session/paladin-session-helper key mic-mute"
  XF86AudioMicMute
"/usr/lib/paladin-session/paladin-session-helper key brightness-up"
  XF86MonBrightnessUp
"/usr/lib/paladin-session/paladin-session-helper key brightness-down"
  XF86MonBrightnessDown
"/usr/lib/paladin-session/paladin-session-helper key play"
  XF86AudioPlay
"/usr/lib/paladin-session/paladin-session-helper key next"
  XF86AudioNext
"/usr/lib/paladin-session/paladin-session-helper key previous"
  XF86AudioPrev
"/usr/lib/paladin-session/paladin-session-helper key stop"
  XF86AudioStop
"/usr/lib/paladin-session/paladin-session-helper key lock"
  Control+Alt + l
"/usr/lib/paladin-session/paladin-session-helper key terminal"
  Control+Alt + t

# Screenshot: Print Screen opens the Screenshot bar (and stops a recording in progress);
# Shift = drag out a portion, Alt = click a window, Ctrl = copy the whole screen to the clipboard
"palos-screenshot"
  Print
"palos-screenshot area"
  Release + Shift + Print
"palos-screenshot window"
  Alt + Print
"palos-screenshot screen --clipboard"
  Control + Print

# Screen Reader: Super+Alt+S on/off; the rest only do something while it's on
"palos-screen-reader --cmd toggle"
  Mod4+Alt + s
"palos-screen-reader --cmd again"
  Mod4+Alt + space
"palos-screen-reader --cmd title"
  Mod4+Alt + w
"palos-screen-reader --cmd all"
  Mod4+Alt + a
"palos-screen-reader --cmd line"
  Mod4+Alt + l
"palos-screen-reader --cmd time"
  Mod4+Alt + t
"palos-screen-reader --cmd faster"
  Mod4+Alt + Up
"palos-screen-reader --cmd slower"
  Mod4+Alt + Down
"palos-screen-reader --cmd echo"
  Mod4+Alt + k
