#!/bin/sh
set -e
case "$1" in
  configure|triggered)
    /usr/lib/palos/branding-apply || true
    if [ "$1" = configure ]; then
      command -v glib-compile-schemas >/dev/null 2>&1 && glib-compile-schemas /usr/share/glib-2.0/schemas || true
      command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload 2>/dev/null || true
      if [ -x /usr/sbin/update-grub ] && [ -e /boot/grub/grub.cfg ]; then update-grub >/dev/null 2>&1 || true; fi
    fi ;;
esac
exit 0
