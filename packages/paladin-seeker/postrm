#!/bin/sh
set -e
case "$1" in
  remove|purge)
    rm -rf /opt/paladin-seeker/runtime /opt/paladin-seeker/runtime.old /opt/paladin-seeker/.runtime-*
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
      apparmor_parser -R /etc/apparmor.d/paladin-seeker 2>/dev/null || true
    fi
    F=/etc/xdg/mimeapps.list
    if [ -f "$F" ]; then
      sed -i '/^inode\/directory=paladin-seeker\.desktop$/d; /^x-scheme-handler\/trash=paladin-seeker\.desktop$/d' "$F"
    fi
    ;;
esac
if [ "$1" = "purge" ]; then
  rm -rf /var/cache/paladin-seeker
fi
exit 0
